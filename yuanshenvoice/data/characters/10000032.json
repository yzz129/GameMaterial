  "voicePackageUrl": "https://huggingface.co/datasets/simon3000/genshin-voice/resolve/main/speaker-archives/Chinese/501-plus/Bennett.zip",
  "voicePackageEn": "Bennett",
  "quoteCount": 73,
  "friendLines": [
    {
      "title": "初次见面…",
      "desc": "这就是你的冒险团吗？真好啊…又热闹，又有人情味。啊，我是「班尼冒险团」的团长班尼特！能把我列入你们的合作伙伴吗？拜托了！",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_draw_appear",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/6f/jna16rusizvz71pjygrsm2ihhzxmy7o.ogg"
    },
    {
      "title": "闲聊·宝藏",
      "desc": "不如在周围找找看吧，说不定有宝藏呢！",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_explore_idle_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f1/f1zv9ws631lm5weu602frxvkgrt4k7d.ogg"
    },
    {
      "title": "闲聊·冒险",
      "desc": "好久没有和别人一起冒险了！我们走吧！",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_explore_idle_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/0c/4dak1u1jlo310u7a08ol7tydguy2z6g.ogg"
    },
    {
      "title": "闲聊·调侃",
      "desc": "俗话说「等在原地是不会有好事发生的」，当然以我的运气来说，往哪里走都一样啦…",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_explore_idle_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/93/2384ypj2w9lgnxh9o0cs1mqffu9ss7f.ogg"
    },
    {
      "title": "下雨的时候…",
      "desc": "我冒险的时候，大多都是这种天气。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_weather_heavyRain_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/05/o504pzxdquys0ycr5dtla54f1f611lo.ogg"
    },
    {
      "title": "打雷的时候…",
      "desc": "啊！别和我站得太近，这样雷就不会劈到你了。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_weather_thunder_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/7f/szqxb0s5bwvppr91ppirc6ju9eu4m7c.ogg"
    },
    {
      "title": "阳光很好…",
      "desc": "今天的天气真不错…啊，糟了，说完这种话多半就要下雨了。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_weather_sunny_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/00/q93lao9lihslcq5mdwx8a47rtvxl2eo.ogg"
    },
    {
      "title": "刮大风了…",
      "desc": "小心点，别被吹过来的石头砸到脑袋了！",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_weather_gale_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/2/23/VO_ZH_Bennett_When_the_Wind_Is_Blowing.ogg"
    },
    {
      "title": "早上好…",
      "desc": "早上好！我们今天去哪儿冒险啊？",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_dialog_greetingMorning",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/13/crixnuoklmjbb9sp5t8769xklk910zg.ogg"
    },
    {
      "title": "中午好…",
      "desc": "我带了三明治，要吃吗？分你一半…唔唔！咳，咳…不好意思，噎到了。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_dialog_greetingNoon",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/bf/bw5p70s91ekb6xjvpurralj73y9vhit.ogg"
    },
    {
      "title": "晚上好…",
      "desc": "要不要陪我去和老爹们聊聊天啊？老冒险家的故事可有意思了！",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_dialog_greetingNight",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e0/10xhmwcwk2fe5k33a21l58g7wto25w8.ogg"
    },
    {
      "title": "晚安…",
      "desc": "要走了吗？能和你一起冒险太开心了，下次记得再叫上我啊！",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_dialog_greetingNight2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/8c/nx0kwlzpy236vde4i065zds6pfn2b92.ogg"
    },
    {
      "title": "关于班尼特自己·冒险团",
      "desc": "我就是「班尼冒险团」的团长，振兴蒙德冒险家协会的希望之星…没见过其他团员？那个…最近他们都请假了，哈哈。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_dialog_idle",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/2f/b3a8jd0dinmdbb51i236q7e979nn1fu.ogg"
    },
    {
      "title": "关于班尼特自己·坏运气",
      "desc": "没有传说中那么夸张啦，不过就是走路经常会掉进猎人打猎用的坑里，或者被突然倒下的树干砸到脑袋，都很平常嘛，对吧？",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_dialog_idle2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/76/ner73pf49ejl0pnh3lmyge2avy6wldq.ogg"
    },
    {
      "title": "关于我们·搭档",
      "desc": "哈哈，不行的，「班尼冒险团」早就满员了…合适的人选有那么多，没必要找我这个倒霉蛋吧？",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_dialog_close",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/1e/fedy5abg2gbkv9mvp1lvrxjh06b0cqf.ogg"
    },
    {
      "title": "关于我们·分工",
      "desc": "以后我负责引走怪物和激活陷阱，你就负责带走宝藏。啊，这样不行吗？哎呀，没事没事！不用担心我会受伤啦，这是我最擅长的！而且为了你的话，我愿意！",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_dialog_close1",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/32/mcp6uxuzoxgm0d1k4joful6xmexaf34.ogg"
    },
    {
      "title": "关于我们·险境",
      "desc": "我终于明白你为什么找我搭档了，你和我很像，一定也很喜欢置身于险境的那种快感吧！冒险就是因为有危险才让人欲罢不能啊。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_dialog_close2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/87/m3gk6kyhaueccvxt3i8hgji2564gxo1.ogg"
    },
    {
      "title": "关于「神之眼」…",
      "desc": "没想到我这么倒霉的人也可以获得神的认可，既然神都没有放弃我，我又怎么能放弃我自己呢？",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_dialog_pendant",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/51/7xhs7izke72390xnrzqls251siqtimo.ogg"
    },
    {
      "title": "有什么想要分享…",
      "desc": "有机会要和我一起去俯瞰蒙德的夜景吗？蒙德城灯火通明，果酒湖反射着月光，特别漂亮…你问我在哪里看到的？哈哈，有一次不小心被龙卷风卷到了特别高的地方…什么？不想去啊，哦，好吧…",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_dialog_share",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fd/ma7ovqm7qbudyny9eugyduzroq1xmjq.ogg"
    },
    {
      "title": "感兴趣的见闻…",
      "desc": "其实我很喜欢卷心菜，看上去很普通，却是一般人家必不可少的食物。它能生长在很多地方，也能和很多食材搭配，还从不抢味道。其实普通一点，也挺好的嘛。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_pref_gift",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/ea/tebvwb7cwx3zru8pzj306nyguaevhnm.ogg"
    },
    {
      "title": "关于芭芭拉…",
      "desc": "她很擅长唱歌跳舞！我冒险不顺的时候就会去看她的演出，跟着观众一起喊喊口号加加油，心情就变好了，真的很神奇！这就是她为什么这么受欢迎的原因吧…啊，我这个当团长的，要是也这么受欢迎就好了。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_teammate_barbara_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/9d/ah7ng1rmec1o0idvvpk34xjvfz023d2.ogg"
    },
    {
      "title": "关于可莉…",
      "desc": "那个孩子啊…很可爱，但我必须和她保持距离。只要我陪她玩，她的那些炸弹就会突然爆炸…我倒霉一点无所谓，但要是炸伤了可莉就麻烦了，估计整个骑士团都会跟我没完吧。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_teammate_klee_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/ac/pc3ua3e5nsnrq1pgxr14uokv2xnhoeb.ogg"
    },
    {
      "title": "关于菲谢尔…",
      "desc": "她是异世界来的「断罪皇女」，可厉害了！我不止一次和她说想要去她的家乡冒险，但每次说到这里她就吞吞吐吐的…嗯，一定是担心我的安危吧，看来她的家乡真的是很凶险的地方。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_teammate_fischl_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/1c/5o1ocl28ma1p9le5wf4gvhxrh96ulu1.ogg"
    },
    {
      "title": "关于琴…",
      "desc": "我本来想向琴团长要一些对蒙德的冒险家协会的支援，但其实我不太知道要怎么和她说…冒险家协会没有骑士团那么多规矩，我和老爹们成天也嘻嘻哈哈的，但用这种态度和琴团长说话，肯定不行吧…我是不是要学一下骑士团敬礼的方式？",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_teammate_qin_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b8/7nm3p7l52e97pcl4blq70kjim6oam0v.ogg"
    },
    {
      "title": "关于法尔伽…",
      "desc": "他是我非常崇拜的人，名副其实的大团长！能领导整个西风骑士团，那该有多厉害啊。不过后来我想了想，冒险团规模太大好像也不行，团里太忙了的话，老爹们就没人照顾了。哈哈，还是现在好啊。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_teammate_varka_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/09/bfwrzrf092stp9axg0817722kxzggb8.ogg"
    },
    {
      "title": "关于雷泽…",
      "desc": "你说奔狼领的那个小哥哥啊，他虽然看上去凶巴巴的，也不愿意说话…但是是个有趣的人哦！他和我都特别喜欢吃肉，我给他做肉吃，他教我狼怎么说话，哈哈，你下次要不要一起来？",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_teammate_razor_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c3/3n24f77q9u4ozhr70iryyss29a5yryo.ogg"
    },
    {
      "title": "关于安柏…",
      "desc": "哦哦，想起来了，那个女孩子，总横冲直撞的…她和我一样，经常去野外冒险！只不过…只要路边架着锅，就总会飘来浓浓的黑烟，还有什么东西烧糊了的味道…唔，难道她的运气也很差？",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_teammate_ambor_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/8b/52wz9naa9ehiti1w4ige9rbw22g3lqw.ogg"
    },
    {
      "title": "关于诺艾尔…",
      "desc": "你说她啊，其实我注意她很久了。她很有天分，又特别努力，但在骑士团只能当女仆，一直没成为正式的骑士，你不觉得太可惜了吗？唉，要是她肯来冒险家协会，估计早就是个了不起的冒险家了。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_teammate_noel_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/a8/si2pryruw9c1hyzsqyhqexv83cch938.ogg"
    },
    {
      "title": "想要了解班尼特·其一",
      "desc": "什么，想要了解我？哈哈，我只是个普普通通的倒霉冒险家，和你的各种传奇经历相比，简直不值一提啊。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_friendship_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/ec/nylgyjbmfbbi1gjx7jpeno8d8mbsfm8.ogg"
    },
    {
      "title": "想要了解班尼特·其二",
      "desc": "「老爹们」…这是我对蒙德的老冒险家们的叫法，听说我是他们在非常险恶的绝境中捡到的孤儿。很奇妙对吧？明明我的运气这么差，居然能被人捡到还活到了现在，简直是奇迹啊。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_friendship_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/50/pqdt0m3bjrb9b90y5vw7s0nh64jrwwj.ogg"
    },
    {
      "title": "想要了解班尼特·其三",
      "desc": "你看出来了啊…呵呵，没错，「班尼冒险团」很久之前就只有我一个人了。因为我很倒霉，无论是多么简单安全的冒险都会变得险象环生，没人愿意跟着这样的团长…你也会这么想吗？",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_friendship_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4f/4xtw38p6jrwx7l5534vw63e58ukjen3.ogg"
    },
    {
      "title": "想要了解班尼特·其四",
      "desc": "我的坏运气是与生俱来的，长这么大也差不多习惯了。其实换种想法，「倒霉」其实也是件好事，因为说不定哪天我的坏运气就会害死我，我才会想趁着还活着的时候，去更多的地方冒险，认识更多的人——不然，可能我就没机会认识你了，哈哈！",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_friendship_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/48/b2cu3c95hyj60id7a5zqc1h2ngwldik.ogg"
    },
    {
      "title": "想要了解班尼特·其五",
      "desc": "不知不觉，我们已经搭档很长时间了。其实我有一个梦想，等到蒙德城的冒险家协会发展成七国里最壮大的协会，我就要去周游提瓦特大陆！「班尼冒险团」会变成最伟大的冒险团，而我们，就是最伟大的两位冒险家！…你问你什么时候加入的？哎呀，这种细节不用在意嘛。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_friendship_05",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/6f/b67ivvo6u8sq8ul8neo35gya2du15fn.ogg"
    },
    {
      "title": "班尼特的爱好…",
      "desc": "我什么都喜欢，但最喜欢的还是冒险！总有一天我会找到这世界上最珍贵的宝藏，到时候老爹们就都能过上好日子，蒙德的冒险家协会也会热闹起来吧！",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_pref_hobby",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/af/m385b1dvwh8lzs9s7hhaeko444le6ab.ogg"
    },
    {
      "title": "班尼特的烦恼…",
      "desc": "硬要说的话…特别倒霉的日子心情会不太好，比如冒险又什么都没找到，或者老爹的身体犯老毛病了之类的，但这些都算不上烦恼，睡一觉就全忘光了。新的一天当然要有新的开始！",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_dialog_annoyed",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/3c/a5y2uso8jrtd9lyifv963y4062wwcbj.ogg"
    },
    {
      "title": "喜欢的食物…",
      "desc": "肉！肉是最能让人精力充沛的食物！野菇鸡肉串，烤肉排，还有甜甜花酿鸡都是我的拿手菜。和我一起冒险，是不会让你饿肚子的。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_pref_foodLike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/61/5meozxwnm4qygu7ird09vg5u5d690qm.ogg"
    },
    {
      "title": "讨厌的食物…",
      "desc": "虽然说冒险家不能挑食，但其实我不是很能吃辣，比如绝云椒椒什么的…吃了之后就喘不上气，感觉呼吸都是辣的，而且之后肯定会拉肚子…这种恶魔一样的果子究竟是怎么长出来的。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_pref_foodDislike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/5a/dbdcb53z0x0rv07cyoyysdiyjccewd0.ogg"
    },
    {
      "title": "收到赠礼·其一",
      "desc": "太幸福了！哈哈…哎呀！会不会把这阵子的好运全部用完了…",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_spice_pref_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fa/683xo7iojp9r47hhzxe2ogjz0d9ctes.ogg"
    },
    {
      "title": "收到赠礼·其二",
      "desc": "无论做什么都很好吃，真不愧是你啊！",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_spice_normal_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/8/85/VO_ZH_Bennett_Receiving_a_Gift_-_02.ogg"
    },
    {
      "title": "收到赠礼·其三",
      "desc": "完了…肚子已经开始疼了…",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_spice_dislike_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/7/71/VO_ZH_Bennett_Receiving_a_Gift_-_03.ogg"
    },
    {
      "title": "生日…",
      "desc": "生日快乐！祝你新的一年也能有最好的运气！放心吧放心吧，倒霉是不会传染的，因为只要有我在，它们就不会找上你了。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_pref_birthday",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/3/30/VO_ZH_Bennett_Birthday.ogg"
    },
    {
      "title": "突破的感受·起",
      "desc": "所有力量都提升了！除了运气，哈哈。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_starUp_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fa/683xo7iojp9r47hhzxe2ogjz0d9ctes.ogg"
    },
    {
      "title": "突破的感受·承",
      "desc": "这样距离你就又近了一步，我会继续努力的！",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_starUp_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c5/kyu3zjgm2eefxszhikif3sgurctoxqp.ogg"
    },
    {
      "title": "突破的感受·转",
      "desc": "得到了这么强的力量，我要怎么报答你呢？对了，我知道一个藏着无价宝藏的秘境，一起去冒险吧？",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_starUp_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fb/to4yptbpwpneugcvie759wcvd99dzbg.ogg"
    },
    {
      "title": "突破的感受·合",
      "desc": "托你的福，现在的我应该有能力保护其他人了，这下子大家都会对我慢慢改观吧——那个倒霉得要命，总是遍体鳞伤的班尼特，终于变成一个可靠的冒险家了！…嘿嘿，但愿吧。",
      "voicefile": "VO_friendship/VO_bennett/vo_bennett_starUp_04",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/a/a1/VO_ZH_Bennett_Feelings_About_Ascension_-_04.ogg"
    }
  ],
