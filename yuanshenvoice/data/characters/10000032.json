  "affiliation": "冒险家协会",
  "cv": {
    "chinese": "穆雪婷",
    "japanese": "逢坂良太",
    "english": "克里斯蒂娜·比·巴伦苏埃拉",
    "korean": "宋河琳"
  },
  "avatarImg": "assets/characters/10000032-avatar.webp",
