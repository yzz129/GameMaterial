      "desc": "咦，刚刚…我想说什么来着…",
      "voicefile": "VO_friendship/VO_qiqi/vo_qiqi_explore_idle_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4e/jwc4h78qv1e6bgsk5t1u9ngbiozbnk5.ogg"
