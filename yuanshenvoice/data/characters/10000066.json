  "hasLocalPack": false,
  "voicePackageUrl": "https://huggingface.co/datasets/simon3000/genshin-voice/resolve/main/speaker-archives/Chinese/11-500/Mitya.zip",
  "voicePackageEn": "Mitya",
  "quoteCount": 70,
  "friendLines": [
    {
      "title": "初次见面…",
      "desc": "此前听绫华屡次提起阁下，不料公务繁忙，直至今日才有机会相见。神里家家主，神里绫人，今后请多指教了。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_draw_appear",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/be/joydmtck4g88felz0vqiwmjzii2agxl.mp3"
    },
    {
      "title": "闲聊·大少爷",
      "desc": "好像忘带什么东西了…算了，等想起来的时候再差人送来好了。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_character_idle_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/71/5ewrc3ckhj1ria3as9gj3cuxlg4mc0t.mp3"
    },
    {
      "title": "闲聊·收网",
      "desc": "暗线已经布置妥当，嗯，差不多该收网了…",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_character_idle_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fe/a56hz7bmz0dz3ri0d9ju8qvh3u8d3pt.mp3"
    },
    {
      "title": "闲聊·恶趣味",
      "desc": "一想起家臣们一脸焦急却又不敢开口阻拦的样子，就忍不住觉得有趣。呵，出来走走是不错。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_character_idle_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/5b/fn6if44jt34mwxoj7un9nm02kkqwwgo.mp3"
    },
    {
      "title": "下雨的时候…",
      "desc": "暂且先避下雨吧，不必着急，很快就会有人来送伞了。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_weather_heavyRain_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/72/0xeve7pw023ea293cy4j0bxfaaqqt1i.mp3"
    },
    {
      "title": "打雷的时候…",
      "desc": "绫华自小害怕打雷，直到家母告诉她雷声是大御所大人的倾诉。从那时起，每逢打雷她都会神色专注，仿佛这样就能听懂大御所大人的言语。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_weather_thunder_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e1/c02f2cfqyojn5dpwqgb0m8k7tv5n5xe.mp3"
    },
    {
      "title": "下雪的时候…",
      "desc": "如今的雪景，与多年前的那场雪…并无二致。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_weather_snowy_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/68/8q7cko36pcilvnz1nxyex4mhfqtoa2i.mp3"
    },
    {
      "title": "阳光很好…",
      "desc": "能悠闲晒太阳的时间可不多。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_weather_sunny_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/ac/lzzxb0u3c57c3exynuf305hs7rr0v3r.mp3"
    },
    {
      "title": "起风的时候…",
      "desc": "有些「突发情况」，看似细小如微风，却会影响到最终结果…呵呵。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_weather_breezy_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/81/ak71k7303n36dqhi3pj9zv8tylh13lt.mp3"
    },
    {
      "title": "刮大风了…",
      "desc": "大多数人会因为大风迷眼而止步不前，只有少部分人能够借势而为。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_weather_gale_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/20/hyja8kzpe5ivwfilziecx9ug5pf2tdw.mp3"
    },
    {
      "title": "早上好…",
      "desc": "早上好。清晨适宜练剑，放松身心。我一般不会让人安排公务。如何？要过上几招么？",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_dialog_greetingMorning",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/40/jsx8uybzrpscqc9g2w76j2q3bcqco20.mp3"
    },
    {
      "title": "中午好…",
      "desc": "午饭如果有偏好的菜色，提前和家仆说就好。你是我的贵客，他们也应对你尽心尽力。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_dialog_greetingNoon",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/ba/cyrv7x90ne3jp7x4m29up7pnifv2q5j.mp3"
    },
    {
      "title": "晚上好…",
      "desc": "既然在这个时间点找我，不如留下来吃晚饭吧。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_dialog_greetingNight",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/95/72nh1n10167viyqqmbjby8ynm67varx.mp3"
    },
    {
      "title": "晚安…",
      "desc": "到洗漱的时间了是吧，你先下去吧，我还不困…呃，是你？我最后再整理下今日的公务便好，你也早点休息。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_dialog_greetingNight2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/bf/7bnax3hmc25eunp0ykvjsr4irle7dm0.mp3"
    },
    {
      "title": "关于神里绫人自己·代价",
      "desc": "万事皆有代价。既然寻求常人无法企及之事，那就必然付出世人无法想象的代价。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_dialog_idle",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/18/sq44dcuewq9w6quedtvw0detzdjyo82.mp3"
    },
    {
      "title": "关于神里绫人自己·手段",
      "desc": "我并不是拘泥于手段的人，无论采取怎样的方式，只要能够取得合适的结果就好。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_dialog_idle2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/0c/0iyxo4n59i9t6at54urftp8fd0usocj.mp3"
    },
    {
      "title": "关于我们·趣事",
      "desc": "呵，我听说了你们在天领奉行那边发生的趣事。能让九条老头气得掉头发的人，真不多见。只可惜没有亲眼见证这一幕啊…",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_dialog_close",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4b/a8acnw1lz69xkj1atclt5putm2h95xn.mp3"
    },
    {
      "title": "关于我们·信任",
      "desc": "信任他人不是一件容易的事，特别是对于位居高位的人来说。一旦错付了，付出生命的代价也不算少见。不过，你已经给了我信任，那我自然也不该辜负。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_dialog_close1",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d0/njiviexcutn3smuu9xf8cmnqrdkeslq.mp3"
    },
    {
      "title": "关于「神之眼」…",
      "desc": "既然有「神之眼」这么方便的道具，自然是要好好利用了。能在我的手中像这样焕发光辉，它也是高兴的吧。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_dialog_pendant",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b6/7ewcvp3p6va3m3lgvyobfzh2suds97o.mp3"
    },
    {
      "title": "有什么想要分享…",
      "desc": "将落花投于暖炉之上，在炉火的炙烤下，花会短暂地恢复生机，最后一刻的红艳更是压火光一筹…倒也没有枉费短暂的一生。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_dialog_share_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/70/jhcvtzrzbvrq7bswi92h7kkdhfchwm8.mp3"
    },
    {
      "title": "感兴趣的见闻…",
      "desc": "说起宠物的话，嗯，我更喜欢狗。猫自我主义的特征是不错，但只有狗会乖乖听从主人的命令。忠诚而又坦率，呵，真是惹人喜爱啊。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_pref_gift_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f5/cqtpeoplgfaa02g914kb94fpsv2nuks.mp3"
    },
    {
      "title": "关于神里绫华…",
      "desc": "我相信绫华的能力，但我也希望她能够保持一颗纯粹的心。权力斗争她不必参与，人世阴暗她也不必直面，这些理应由作为兄长的我来一一扫清…不小心说太多了，就当是你我之间的秘密吧。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_teammate_ayaka_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/be/nkdgmqz7tvk6cpk2ix9u4oso8l41m9m.mp3"
    },
    {
      "title": "关于托马…",
      "desc": "托马对神里家的忠心毋庸置疑。很久以前我曾试探过他，如果不想往后被卷入无尽纷争的话，最好早日离开。他却还是留了下来，一直跟随着神里家，让我也省心不少。…现在，我完全信得过的人很少，托马算是一个。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_teammate_thoma_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/04/doyv8m9r85lq6cx4oogpeuqdy7eqhl1.mp3"
    },
    {
      "title": "关于早柚…",
      "desc": "她平时看起来是懒散了点，但在适当的时机，却总能给予重要帮助。你应该再清楚不过了吧？",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_teammate_sayu_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c7/5zmjkkahqfc7mvliebwxc1zao8vkuk7.mp3"
    },
    {
      "title": "关于宵宫…",
      "desc": "那位…为人爽朗的烟花店店主么？嗯…她和神里家往来还算密切。她和绫华年龄相仿，也很投缘。绫华恐怕也不会因为她的快人快语而困扰。毕竟绫华那孩子在小时候，就能坚定地守住本心。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_teammate_yoimiya_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/5a/91wmtv62ptfga85pyjea4rrpvu49oly.mp3"
    },
    {
      "title": "关于雷电将军…",
      "desc": "为了追求「永恒」，将军大人以及整个稻妻，都付出了不小的代价。伤口需要时间来愈合，作为政局的调和者，我必然会尽到我的责任。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_teammate_raidenShogun_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/dc/2vlqcrrc8sjk51588ynmrcfpn8uo7ou.mp3"
    },
    {
      "title": "关于八重神子…",
      "desc": "宫司大人于神里家有恩，可她却一直不太看得惯我，呵，恐怕你没少听她「那小子」「那小子」地称呼我吧。\n由于业务交集，我们偶有碰面，虽说大家各怀心思，但工作起来也称得上融洽。我并不讨厌这种感觉。嗯，与聪明人一起办事，效率就是会高得多。况且就算她再讨厌我，也不得不承认如果没有我，就没人能实现得了她那些「奇思妙想」了。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_teammate_yaeMiko_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d7/6qj6qhrsriqlam9vg6gkcnoen165uz4.mp3"
    },
    {
      "title": "关于九条裟罗…",
      "desc": "九条老头打得一手好算盘，磨砺出了一柄利剑。哼，只可惜，他没有算到，自己做不起这位执剑人。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_teammate_kujouSara_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/ff/0ug47cy17916gof2m582j4t8rl2j8qs.mp3"
    },
    {
      "title": "关于枫原万叶…",
      "desc": "枫原家曾是神里家的下属，神里家的先祖当年未能保护他们周全，到我这里，仍有义务照拂他。虽说无法助他重振家业，但帮他逃脱天领奉行的追捕这种事还是做得到的。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_teammate_kazuha_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4f/oyz1z75s7mpkeertegk1kk1ycfifyj2.mp3"
    },
    {
      "title": "关于荒泷一斗…",
      "desc": "那家伙实在是个有趣的人。让温顺的鬼兜虫相互争斗，哈哈，有意思。嗯，虽然那次点拨实则是不经意之举，但没想到的是，他竟会直接与我称兄道弟，而且时至今日都还没发现我这位「绫人兄」的身份。呵呵，这样也好，我并不讨厌…单纯的人。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_teammate_itto_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/3a/l7zvoqbf5550fp1ywz6qz5zmhart385.mp3"
    },
    {
      "title": "关于凝光…",
      "desc": "璃月七星中的那位「天权」大人，嗯，她的手段我也略有耳闻。说来，我还收藏有一套限量版的「璃月千年」，你感兴趣吗？我差人拿出来，我们下一盘如何？",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_teammate_ningguang_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fe/galdaeasxaf04fllbp474j6xayifdqc.mp3"
    },
    {
      "title": "想要了解神里绫人·其一",
      "desc": "我的事情吗？有时候知道得太多不一定是好事，你应该也听说过类似的谚语吧。下次有机会再聊吧。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_friendship_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e5/rgg0me930lq6i36brqc7kewc25hljz7.mp3"
    },
    {
      "title": "想要了解神里绫人·其二",
      "desc": "品味…奇特？看来你对我有什么误解，我得澄清一下才是。多数时候，我只是喜欢看人脸上为难的表情罢了。难道这很奇怪吗？你应该也没少逗你边上的小家伙吧？",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_friendship_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/48/9aaigdncr0czh3mvt1k4iuzsqn2wsg9.mp3"
    },
    {
      "title": "想要了解神里绫人·其三",
      "desc": "三奉行之间，表面看起来风平浪静，实际上却暗潮涌动。哼，和那些老家伙们周旋，并不是什么愉快的事，不值得细说。你只需知道…昔日是为了神里家的稳定，今日是为了稻妻的大局，我从未行有愧于神里家家主之名之事。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_friendship_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/06/csvp4useckxfeqjj91945u3omg1sxj3.mp3"
    },
    {
      "title": "想要了解神里绫人·其四",
      "desc": "终末番吗？和你说说倒也无妨。那是直属于神里家家主的一支秘密部队，家父去世后，便由我接手了。我不能直接出面解决的事情，有了终末番就方便不少。里面的成员大多是孤儿，从小就被组织收养，这样才能最大程度保证忠诚，也能让人放心。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_friendship_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/29/m8cgqb84vm47ahn9o3cb2cynmtasr66.mp3"
    },
    {
      "title": "想要了解神里绫人·其五",
      "desc": "除了终末番以外的底牌？呵，自然是有的，狡兔有三窟，更何况人呢？只是我的秘密已经说得差不多了，该来听听你的故事了吧。哦对了，在提瓦特大陆上旅行的部分就不用了，说些更久之前的吧。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_friendship_05",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/cd/h548koefsfjv0us9subkmuw9x6yp60z.mp3"
    },
    {
      "title": "神里绫人的爱好…",
      "desc": "爱好…小时候倒是略有一二，不过如今公务占据了大多数时间，不提也罢…嗯？你说有人把公务当成爱好？呵，这可真是…嗯…独特。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_pref_hobby",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/80/aw81r2ax5an124qpo86teflldgbaavx.mp3"
    },
    {
      "title": "神里绫人的烦恼…",
      "desc": "烦恼吗？如果一件事让我烦恼，那就得尽快处理好。如果一个人让我烦恼，呵…",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_dialog_annoyed",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/23/qms1sxn3n8fqxm1bc06os458w3zc4yc.mp3"
    },
    {
      "title": "喜欢的食物·个人喜好",
      "desc": "新奇的事物能给枯燥的日常生活带来新鲜感。最近花见坂那边新出的什锦奶茶就很不错，你也该试试。不过…日常饭菜上我没有什么偏好。每日用餐有专门的下属制定计划。对方端来什么，我就吃什么。",
      "voicefile": "VO_friendship/VO_ayato/vo_ayato_pref_foodLike_01",
      "localAudio": null,
