  "affiliation": "南十字船队",
  "cv": {
    "chinese": "斑马",
    "japanese": "岛崎信长",
    "english": "马克·威顿",
    "korean": "金信旴"
  },
  "avatarImg": "assets/characters/10000047-avatar.webp",
