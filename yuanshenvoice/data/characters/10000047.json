  "voicePackageUrl": "https://huggingface.co/datasets/simon3000/genshin-voice/resolve/main/speaker-archives/Chinese/501-plus/Kaedehara_Kazuha.zip",
  "voicePackageEn": "Kaedehara_Kazuha",
  "quoteCount": 73,
  "friendLines": [
    {
      "title": "初次见面…",
      "desc": "「飘摇风雨中，带刀归来赤脚行」…我的名字是枫原万叶，游历四方的浪人。既然你我都在旅行的路上，这段路不妨结伴同行。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_draw_appear",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/3e/pfu7mnyysrat310mhrm6az5m6e9ymw4.mp3"
    },
    {
      "title": "闲聊·自然",
      "desc": "见到了这么美丽的景色，自然会产生云游四海的想法吧？",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_character_idle_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d5/fe99za20im6wusqrtq291q9xxhbazea.mp3"
    },
    {
      "title": "闲聊·吹奏",
      "desc": "既然手边有树叶，我可以为你吹奏一曲。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_character_idle_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d5/scrkw06an8bhd2dwj7xix913x5mo6fr.mp3"
    },
    {
      "title": "闲聊·剑技",
      "desc": "飘摇风雨中，睹物思故乡，这把刀…是我与故乡唯一的联系了。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_character_idle_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/da/3ysor0b5fq40jtyqscs9lgkpiib8t1o.mp3"
    },
    {
      "title": "下雨的时候…",
      "desc": "在大雨中漫步，让人神志清醒。不过等雨停之后，还是尽快把衣服烤干比较好。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_weather_heavyRain_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f8/nm2rol04yg2hik2ae34o28f95m3sko1.mp3"
    },
    {
      "title": "打雷的时候…",
      "desc": "比起在海上航行时遇到的雷暴，这倒也算不上什么。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_weather_thunder_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/14/qq6e9725rx45x81u4zwsd0vy74unjdt.mp3"
    },
    {
      "title": "下雪的时候…",
      "desc": "我喜欢下雪，雪后的世界很安静，无人来扰我清梦。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_weather_snowy_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/3a/au2o3qbrr9p4eftobmwtyqdsjdhvjs7.mp3"
    },
    {
      "title": "阳光很好…",
      "desc": "晴空万里，真让人心情愉快。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_weather_sunny_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fb/8nvri99fmmv1vkq5qow7i99tnuc2r20.mp3"
    },
    {
      "title": "早上好…",
      "desc": "清晨的鸟鸣，是大自然的馈赠。启程吧，属于我们的旅途也要开始了。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_dialog_greetingMorning",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/0e/jagwtta2u34e39p5xfvhbl4qynu4t68.mp3"
    },
    {
      "title": "中午好…",
      "desc": "正午的阳光，让人想要小睡片刻。找个地方休息一下如何？",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_dialog_greetingNoon",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/92/bhluvak398c9ppssgbbbvcqjdhbu3hy.mp3"
    },
    {
      "title": "晚上好…",
      "desc": "抬头见月，侧耳听风，壶中有酒，我心太平…\n晚上好。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_dialog_greetingNight",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/35/1yvwynixv1bfa3r08bbr9motjny3o2d.mp3"
    },
    {
      "title": "晚安…",
      "desc": "风停了…\n安静的世界，适合好好休息。明天见。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_dialog_greetingNight2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/2b/ttngoonll1vznb65x7qitujf31zdo3i.mp3"
    },
    {
      "title": "关于枫原万叶自己·航行",
      "desc": "其实，大海并非每晚都充满风浪。天气清朗的时候，月光倒映在摇晃的海面上，鱼群在船舶的周围随行。我坐在船头眺望远方，会觉得这段旅程非常值得…唯一的遗憾是水手们的歌声太吵了，他们不用睡觉的吗？",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_dialog_idle",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/84/minp6nf6t9uryyfkjqpp2mgpbrpjh5t.mp3"
    },
    {
      "title": "关于枫原万叶自己·贵族武士",
      "desc": "枫原家曾经也是有名的武士门第，可惜传承到我这里时，除了贵族的名号外已经别无长物。不过对我来说倒也足够了，武士不需要富足的生活，我们需要的是诗歌、美酒与手中的刀。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_dialog_idle2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/1e/q92tgiw6i35xud1jzuftk8bt6w2uy8s.mp3"
    },
    {
      "title": "关于我们·出海",
      "desc": "找个好天气，出海看看如何？",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_dialog_close",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c7/lxalqcnn49mkiyw29mw8effemcaikzy.mp3"
    },
    {
      "title": "关于我们·畅谈",
      "desc": "我喜欢性格爽朗的人，这样相处时可以畅所欲言。有什么想说的不必藏在心里，我能够听到自然万物的声音，其中也包括你的声音。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_dialog_close1",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/00/et6ji3d3r14h6mg84f2jj13fspoi6je.mp3"
    },
    {
      "title": "关于「神之眼」…",
      "desc": "在我看来，神之眼是力量的「证明」，而不是力量的「来源」。神之眼象征的是凡人继续向前的愿望，而我们武士的底气，一直都是手里的刀。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_dialog_pendant",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e1/mvby29b129ok7d8wqvdbra7jh3ua7da.mp3"
    },
    {
      "title": "有什么想要分享·竹刀",
      "desc": "想学剑道的话…我想想，拿着这个吧，这是我刚刚做好的竹刀。用这个切磋的话，我们就都不会受伤了。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_dialog_share_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e9/saglol0kgf6u82s1g8k1w7g78g1b0e5.mp3"
    },
    {
      "title": "有什么想要分享·枫叶",
      "desc": "「深山踏红叶，耳畔闻鹿鸣」…我很喜欢枫叶，可惜枫叶红时总多离别。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_dialog_share_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/8b/s4goev4tdqxj3aqghmxfu8wl1mqgq2n.mp3"
    },
    {
      "title": "感兴趣的见闻…",
      "desc": "海鸥别叫啦，从今天起，我也是漂泊者呀。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_pref_gift",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/ce/hwxu3kp0e957kkp7o17jkvvxu88oenh.mp3"
    },
    {
      "title": "关于北斗…",
      "desc": "北斗大姐头是我的恩人。大姐头她收留了从稻妻逃出来的我，并在我最困难的那段时期里，给了我重返稻妻的勇气。她是我和所有船员可以托付后背的战友。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_teammate_beidou_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f3/98ji9n3pard9outhr90afz61n6wprn9.mp3"
    },
    {
      "title": "关于五郎…",
      "desc": "我在被通缉的那段时间里，反抗军给了我许多帮助。那时候我与五郎只有短暂的接触，但我对他的印象很深刻。他是那种有话就说的直性子，与部下同甘共苦，为朋友两肋插刀，与我很合得来。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_teammate_goro_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/30/5vax2uvrq6v26bcmwhl7tikius9ch51.mp3"
    },
    {
      "title": "关于九条裟罗·态度…",
      "desc": "能在御前决斗中战胜我的朋友，我确实认可她的实力。但她却用这样的力量为虎作伥，带领九条军不断回收「神之眼」，我无法原谅。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_teammate_kujoSara_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fd/p4apw51tph9xib21bopoinu727nj8ym.mp3"
    },
    {
      "title": "关于九条裟罗·改观…",
      "desc": "原来如此。看来她也有自己坚持的信念。只是不知道风波平息后，「九条」家还能否延续曾经的昌盛。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_teammate_kujoSara_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/88/0lnxocat9xngpvwk5h32h8xlpwqoysw.mp3"
    },
    {
      "title": "关于雷电将军…",
      "desc": "离开稻妻后，我许多次扪心自问，我对雷电将军的不满是否源于那一次御前决斗，是否源于她对友人落下的那一刀？\n我想了很久，觉得不是的。我的友人是堂堂正正地死在了决斗场上，雷电将军的那一刀也并无不妥。我对她的不满，来源于「眼狩令」。没有任何人有资格剥夺他人的愿望，即便是「神」也不行。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_teammate_raidenShogun_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/9a/lmu07sstxa9mx09u35qnafqxewlh7u7.mp3"
    },
    {
      "title": "关于神里绫华…",
      "desc": "生活在稻妻的人，应该都听过「白鹭公主」这个名字吧。神里家的大小姐，近乎完美的一个人，不过我跟她没什么交集，不知道她对如今的稻妻抱有怎样的看法。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_teammate_ayaka_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4f/pxg12axs0km8s9x58ye39wo7faq2e97.mp3"
    },
    {
      "title": "关于宵宫…",
      "desc": "上次她托大姐头把烟火运到璃月，还是我亲自去卸的货。好沉！除了她以外，应该没人能造出这么大的烟火了吧。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_teammate_yoimiya_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b6/kgwr187joccvlh3zans7w9wyqsfg5ui.mp3"
    },
    {
      "title": "关于珊瑚宫心海…",
      "desc": "我在反抗军的时候，周围的同伴无不对珊瑚宫大人充满敬仰。她爱惜兵力，很少会做出不计死伤的打法，总是能够用最小的代价取得胜利。听说她还要统管海祇岛的政务和外交，真的忙得过来吗…",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_teammate_kokomi_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/50/o50eparjvr21je7ezj8e10ala78y4jr.mp3"
    },
    {
      "title": "关于鹿野院平藏…",
      "desc": "别看我这位侦探朋友平日里潇洒随性，一旦他办起案子来，那些原本围绕在他身旁活泼灵动的风，就聚成了凌厉锐气。确实让人钦佩。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_teammate_heizou_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/91/o6jampx28c7xcutwoyshd9lpph59dw0.mp3"
    },
    {
      "title": "想要了解枫原万叶·其一",
      "desc": "想要了解我的事？如你所见，我只是个随处可见的流浪武士。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_friendship_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/cf/ly7fuzm2rako6qx0sg70tvpmbk4ou5z.mp3"
    },
    {
      "title": "想要了解枫原万叶·其二",
      "desc": "我的耳朵很敏锐，能够听到各种各样的声音。比如风吹过山岗的声音，云散开的声音，林间的小狐狸啃咬苹果的声音，螃蟹吐泡泡的声音…这是自然万物对我的眷顾，让我总能提前发现危险的到来。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_friendship_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/07/l05uguc1leu74ijnndiaqjo2wrz3k8y.mp3"
    },
    {
      "title": "想要了解枫原万叶·其三",
      "desc": "小时候我很喜欢下雨，那种沙沙的声响容易给人一个安稳的梦。但长大了以后，对雨的感情就变得复杂了许多…虽然依旧喜欢听雨，但每次看到乌云的时候，却又忍不住感叹「今天能不能找到好心人让我借宿呢」。穿着湿漉漉的衣服听雨，往往会被喷嚏声打断了情调。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_friendship_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/19/a9uhi8i6rlbl3dea1l8nessjxmd7slq.mp3"
    },
    {
      "title": "想要了解枫原万叶·其四",
      "desc": "我不会在一个地方驻足太久。因为太久的停留会让我跟「自然」产生隔阂，也会让我手里的刀变钝。趁我还能远航，我希望自己能去各种各样的地方，见到不同的人们。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_friendship_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/06/rwerat40ixgnna2hlz17gj0wasobeoh.mp3"
    },
    {
      "title": "想要了解枫原万叶·其五",
      "desc": "不必担心，就算有一天我们去往不同的地方，也一定会在世界的某处再次相遇。人与人的「缘」不是那么容易就断掉的东西。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_friendship_05",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/94/s4ckdduhhy92wpjvvz4dyev6nqdv437.mp3"
    },
    {
      "title": "枫原万叶的爱好…",
      "desc": "躺在被正午的阳光晒暖的岩石上休息，醒来后继续漫无目的地前行。只要与刀相伴，我可以去任何地方。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_pref_hobby",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/10/ksjptnk40m4bvpbyj3mkvt8di3p53mt.mp3"
    },
    {
      "title": "枫原万叶的烦恼…",
      "desc": "每逢风暴降临的时候，「自然」的声音就会变得嘈杂，我的耳朵也会嗡嗡作响。如果是在晚上的话，往往会辗转许久都无法入眠，让人有些头痛。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_dialog_annoyed",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/47/4pged50ndbrcogzj8rhpd2if1p0mu7q.mp3"
    },
    {
      "title": "喜欢的食物…",
      "desc": "在大海上航行时，最容易获取到的食材便是鱼肉。怎么样把鱼做得好吃，是每个在海上冒险的人都要思考的问题。有机会的话，也想让你尝尝看我的手艺。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_pref_foodLike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d9/hjb4a87gapx505m2dzlgmt7c2m3neoo.mp3"
    },
    {
      "title": "讨厌的食物…",
      "desc": "我呢，不是特别喜欢那些粗制的食物。在我看来，就算是一条普普通通的鱼也要烧得好吃才行，吃东西本应是让人身心愉快的事情，怎么能将就呢？",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_pref_foodDislike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/9a/3fbj0g76wy5kfna024mz5x92w2yn72e.mp3"
    },
    {
      "title": "收到赠礼·其一",
      "desc": "能将鱼肉烹调出如此滋味，你的手艺当真了得。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_spice_pref_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c3/drc6f6ll8fkm6viu2j6g10cz8zj45xj.mp3"
    },
    {
      "title": "收到赠礼·其二",
      "desc": "你做的饭菜不仅能够饱腹，对我而言也是慰藉。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_spice_normal_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/3b/8rd5x25ceef0iehcsantfrdg0jt43ze.mp3"
    },
    {
      "title": "收到赠礼·其三",
      "desc": "要休息一下吗？内心疲惫的话，做出来的菜也会失去风味。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_spice_dislike_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/89/p0u14o4ockt2x1s3iy5pf1sbsrgbo3q.mp3"
    },
    {
      "title": "生日…",
      "desc": "哈…得知今天的生日，我特地写了新的诗歌。只可惜诗才不佳，几个晚上只想到前两句，就先送给你吧。\n「流光换日月，鹤归云起庆生时」…欸等等，先别说话，我有灵感了。最后一句…「异乡有故知」，如何？\n生日快乐，今天一起去…吃点甜品吧。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_pref_birthday",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/cb/ebs8w7kztkkxb76oifu04t3i059tsgk.mp3"
    },
    {
      "title": "突破的感受·起",
      "desc": "这把刀，更加锋利了。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_starUp_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b9/c10brk1a2whkkrj1f7yecv6jikltd70.mp3"
    },
    {
      "title": "突破的感受·承",
      "desc": "雪落在地上的声音，细不可闻…但现在的我，应该可以听到了。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_starUp_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d5/9wce7txdl76e7lgtumzazu9u5u5xdop.mp3"
    },
    {
      "title": "突破的感受·转",
      "desc": "海上的风浪很大，我也要变得更强。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_starUp_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/a2/7mn882blyiu0dgketngdxtnxoy1ai3h.mp3"
    },
    {
      "title": "突破的感受·合",
      "desc": "行走世间，自然会有各种烦恼相伴，但既得与你相遇，不管是武艺还是内心都有了新的成长。想必今后的人生也会更加自在吧。",
      "voicefile": "VO_friendship/VO_kazuha/vo_kazuha_starUp_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/96/sy6ps5jju42ejglwc7xsom0icpa51x9.mp3"
    }
  ],
