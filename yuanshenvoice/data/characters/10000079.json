    "korean": "金琄心"
  },
  "avatarImg": "assets/characters/10000079-avatar.webp",
  "splashArt": "assets/characters/10000079-art.webp",
  "hasLocalPack": false,
  "voicePackageUrl": "https://huggingface.co/datasets/simon3000/genshin-voice/resolve/main/speaker-archives/Chinese/501-plus/Dehya.zip",
  "voicePackageEn": "Dehya",
  "quoteCount": 69,
  "friendLines": [
    {
      "title": "初次见面…",
      "desc": "我叫迪希雅，就是你想要雇佣的那位佣兵。你有什么委托？打架？护送？无论是什么事，只要开口就行。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_draw_appear_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c7/t899lg1uxlpia3r7g67etir18lktg8i.mp3"
    },
    {
      "title": "闲聊·佣兵",
      "desc": "你问佣兵的工作原则？嗯…很简单，谁出的钱多，就给谁办事。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_character_idle_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/87/d3iebhebftxju8b0ho4sfntszbxbx8d.mp3"
    },
    {
      "title": "闲聊·沙漠",
      "desc": "沙漠是个难相处的对手，但至少它足够光明磊落，把所有艰险挑战都放在台面上给你看。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_character_idle_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/aa/idndfxszq6i944hrv8cff08jc0ralkx.mp3"
    },
    {
      "title": "闲聊·我们的人",
      "desc": "我们的人已经习惯了沙漠…但我还是希望他们在某天能够告别风沙，在某处绿洲更愉快地生活。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_character_idle_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/a3/48y5wk766oye9qxw9qz9aymtx2pjqd1.mp3"
    },
    {
      "title": "下雨的时候…",
      "desc": "听佣兵团里的老人说，沙漠里偶尔也会下雨，而且雨势比这猛烈得多。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_weather_heavyRain_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/eb/odpiym5d3g6xjst956t3oa3bxamenq7.mp3"
    },
    {
      "title": "打雷的时候…",
      "desc": "这雷鸣声可够大的…可以掩盖住很多声音。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_weather_thunder_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/21/1guk4fm9epavx48zkt3ix962su6p9md.mp3"
    },
    {
      "title": "下雪的时候…",
      "desc": "呼…这里简直比夜晚的沙漠还冷。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_weather_snowy_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f1/5y1igeqz4ky1wp4ojprrpelviffa38o.mp3"
    },
    {
      "title": "阳光很好…",
      "desc": "天气很好，要是我手里的活也能轻松点就好喽。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_weather_sunny_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/0b/1ockp6d37ti4cras5nr6z5wu8lbs4cp.mp3"
    },
    {
      "title": "刮大风了…",
      "desc": "起风了，我们去下风口扎营比较安全。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_weather_breezy_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/bc/ibgvucxl39yt41u4xgmugngs3pgeupt.mp3"
    },
    {
      "title": "在沙漠的时候…",
      "desc": "跟紧我，不要乱走，沙漠可不会对任何人留情。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_weather_desert_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e0/b7sl9xrsyg713nc9tfaz3gigy2uxl8o.mp3"
    },
    {
      "title": "早上好…",
      "desc": "你看起来精神不错，那我们等会就拔营出发吧。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_dialog_greetingMorning",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/64/azd28isg7yfzufin4kbujbp3vxnyxp5.mp3"
    },
    {
      "title": "中午好…",
      "desc": "已经中午了…等我找到合适的位置，就可以搭灶做饭了。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_dialog_greetingNoon",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4f/1behr4ec080fz8edqi2i34rsz3b990f.mp3"
    },
    {
      "title": "晚上好…",
      "desc": "这么晚了你还在工作？真是比我们佣兵都辛苦啊。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_dialog_greetingNight",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/60/jgjvkv75huusrapfmr7fkpdbgxoua79.mp3"
    },
    {
      "title": "晚安…",
      "desc": "时间不早了，今夜的值守就交给我，你快去休息吧。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_dialog_greetingNight2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/01/f8tl6szk9vgnne7bnmkv57jbmp8llm5.mp3"
    },
    {
      "title": "关于迪希雅自己·镀金旅团",
      "desc": "镀金旅团只是一个「头衔」，任何须弥的佣兵都可以自称为「镀金旅团」的一员。有些佣兵就用这头衔来唬骗外地人。哼，拜这帮人所赐，现在「镀金旅团」的名号已经越来越招人厌了。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_dialog_idle",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/81/rdbxy42yc9b34i2jb70iwd40rimifr7.mp3"
    },
    {
      "title": "关于迪希雅自己·老爹",
      "desc": "库塞拉…他是个吊儿郎当，喜欢装模作样的佣兵。是他从沙漠里救了我，又用尽全力，将他一切能够给予我的东西，都给了我。\n但正是因为他，我才能成长为现在的我。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_dialog_idle2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/3a/qbmo6giscefkm13rx22taid7jzqcegv.mp3"
    },
    {
      "title": "关于我们·伟大事迹",
      "desc": "你最近可是大显身手啊，我所在的佣兵团里都有不少人一直在讲你的事迹，甚至还有几个人来问我，能不能向你引见一下他们。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_dialog_close",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/3d/c3xsprhzahiyvtjbuw01w9tzrd0gcik.mp3"
    },
    {
      "title": "关于我们·战友",
      "desc": "朋友？嗯…我们一起经历了那么多事，共同闯过了那么多场战斗，用「朋友」来形容我们之间的关系，总感觉有点轻飘飘的。\n我想想…不如，用「战友」吧，这种感情只能从并肩的战斗中锤炼而出，是最不可动摇的东西。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_dialog_close1",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/5b/6xymh5lx7ilc74h9pkh9845afq7i1oc.mp3"
    },
    {
      "title": "关于「神之眼」…",
      "desc": "「神之眼」给我带来了什么？嗯…老实说，比起战斗时的便利，这枚「神之眼」更大的作用，是让更多的佣兵慕名而来加入「炽光猎兽」。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_dialog_pendant",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/97/3lip2j4rciu5l7nu93yozybnwtc2ds2.mp3"
    },
    {
      "title": "有什么想要分享…",
      "desc": "你知道枣椰吗？我小时候最喜欢吃这种果子。但老爹完全不知道拆枣椰的方法，就拿着刀胡乱地戳来戳去，把里面的果肉都弄得乱七八糟，完全没办法下口吃。最后只能把果肉都刮下来，混在牛奶里，勉强给我当做粥来吃。\n我有时候也会怀念这种粥的味道，还有那个拆枣椰都能拆得手忙脚乱的老爹。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_dialog_share_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/50/0xw01bd0rflzgmdr0yixaj01uq9ee5r.mp3"
    },
    {
      "title": "感兴趣的见闻…",
      "desc": "在一些人眼里，啃食残骸的赤鹫是带来死亡与灾厄的生物。但在我看来，这些翱翔在沙海之上的鹫鸟，有着最热烈的生命力。\n不知道当它们从天空往下俯瞰时，大赤沙海会是一个什么模样。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_pref_gift_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/0c/rj8u5bk17ifqxw637ad5ym2pij7d1gi.mp3"
    },
    {
      "title": "关于提纳里…",
      "desc": "哈哈哈，你别说，我还真的差点和这位巡林官做成过一笔生意。之前我经人介绍，要做他进沙漠考察时的向导。不过后来不知道为什么这单生意取消了，我记得…好像是这位巡林官实在耐不住热，还是其他什么原因来着。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_teammate_tighnari_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e2/bdb3dcka8gn5zz0hxxmlfzzih99q1vc.mp3"
    },
    {
      "title": "关于小吉祥草王…",
      "desc": "哼，我之前还以为，教令院里顶多是有一群自私自利的鬣狗在蝇营狗苟，结果…居然还有这么几匹喂不熟的白眼狼在作乱。依我看，那位小吉祥草王真是慈悲得有些过头了，对付这种劣兽，最好是连骨头都锤碎掉！就这么放他们去林子里歇着，真是太便宜他们了。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_teammate_nahida_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f4/qhjuwk32tnjy9se7yvirlztjjllmr4k.mp3"
    },
    {
      "title": "关于坎蒂丝…",
      "desc": "你说坎蒂丝啊，她什么都好，就是性子犟得和驮兽一样。我和她说了好多次，别老是绷着弦，偶尔也要给自己放个假，比如去须弥城里逛逛，买点漂亮衣服首饰…但她总是说不放心村子，拒绝了我好多次。唉，实在不行，下次我帮她守村子，然后再拜托团里的妹子们带她进城玩玩好了。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_teammate_candace_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/66/2wbk5krp7zkhklmiof8l4ikcyheco2p.mp3"
    },
    {
      "title": "关于艾尔海森…",
      "desc": "他曾经邀请我过去教令院任职，但我过不惯那种死水一潭般的生活，就拒绝了。不过这位书记官说话时那种七拐八绕，又夹枪带棒的腔调，倒是很符合我对教令院学者的印象…",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_teammate_alhaitham_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/53/6454toxha7lr4r300pvxqklqirahrid.mp3"
    },
    {
      "title": "关于赛诺…",
      "desc": "那位「大风纪官」？是个雷厉风行的狠角色，处理某些事情的方法，也挺对我胃口的。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_teammate_cyno_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/5c/ts48pxe42khfsac9xkoi4j3tvg4qjox.mp3"
    },
    {
      "title": "关于妮露…",
      "desc": "解决了那件事之后，妮露也能更加自由地跳舞了吧。哦她上次还说，要把自己用的香粉捎一份给我，但我经常在外面奔波，就只能让她先送去坎蒂丝那里。唔…我也该找个时间过去看看了。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_teammate_nilou_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/8f/46ltfaby688k3697i46un6dkdsctzwu.mp3"
    },
    {
      "title": "关于多莉…",
      "desc": "那个商人啊。据说她那里什么都有得卖，只是价钱贵了点？哈哈，那我还挺希望和她见几面的，毕竟…有些佣兵需要的东西，在市场上真是拿钱都买不到啊。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_teammate_dori_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/40/tu4e9k8amul43qpozzlqdehcsv4oznn.mp3"
    },
    {
      "title": "关于莱依拉…",
      "desc": "那个成天迷迷糊糊的小丫头啊，我有印象。之前我在沙漠边缘的一个绿洲碰见过她，她好像是跟着教令院的什么队伍来观察星象，不过我也没有太留意。啥？坎蒂丝…星空的使者…这都什么乱七八糟的？这丫头不会还没睡醒吧。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_teammate_layla_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e5/mbi1lfcc67gbnw8ffw8dbez9qvpeypu.mp3"
    },
    {
      "title": "关于赛索斯…",
      "desc": "我也是最近才知道他来自缄默之殿。哎呀，不好意思，我对缄默之殿这类神秘组织了解很少嘛。以前倒是在沙漠里见过他几回，他很好沟通，我的佣兵兄弟在沙漠遇到麻烦，他还把饮用水分给他们过。是个不错的人。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_teammate_sethos_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/80/ljd0rowcyyfdexrpdbjoph6vd6yt8bh.mp3"
    },
    {
      "title": "想要了解迪希雅·其一",
      "desc": "我自小就在佣兵团里生活，玩具是木刀木剑，认识的人要么是佣兵，要么准备做佣兵，就连吃饭的木碗都是团里的人拿刀削出来的木碗。在这种环境下长大，要是我不做佣兵反而有点奇怪，对吧？",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_friendship_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/80/ljd0rowcyyfdexrpdbjoph6vd6yt8bh.mp3"
    },
    {
      "title": "想要了解迪希雅·其二",
      "desc": "我是哪里人？这我可不知道，我从来都没想过这方面的问题。但硬要说的话，我一直生活在沙漠里，应该算是「沙漠这边」的人吧。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_friendship_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/1d/j1bhwwsy412rcompnw1mjsqjjg8teyz.mp3"
    },
    {
      "title": "想要了解迪希雅·其三",
      "desc": "佣兵的工作可不容易，先不说接受的委托难度如何，更让人头疼的是完成委托后如何让客户迅速地结清钱款。教令院结钱最爽快，冒险家协会其次，结钱最不爽快的是那些做货物贸易的商人，他们总是说自己的资金正在周转，暂时拿不出多少现钱，让我再等等。\n嘁，拿不出钱，那他们车上那么多货是怎么来的？",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_friendship_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/1b/rn6i0ynb267ncmukk2w5u90zxiy1p83.mp3"
    },
    {
      "title": "想要了解迪希雅·其四",
      "desc": "在之前那件事过后，教令院对于我们的态度也有了改变，据说还推出了一大堆帮助沙漠子民的条款。呃，那一大堆文件我是看不懂了，我只希望「防沙壁」从今往后只隔绝风沙，不要再阻断希望。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_friendship_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/77/ri6u6kpxnlvgeoe1wh431tbb652r6b4.mp3"
    },
    {
      "title": "想要了解迪希雅·其五",
      "desc": "大部分佣兵的抱负就是扬名立万，他们不断地接受高难度的委托，赚取财富和名声。有的人幸运地活下来，成为了传奇，有些人就在沙漠里默默无闻的消失。\n但我可没有那么「远大」的抱负，我只想要保护周围的人，让他们能安心地生活，这就足够了。要是能再赚点钱，那就更好了，哈哈。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_friendship_05",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f5/kbeptotzwk276jtufy6q1h9fjpojkj6.mp3"
    },
    {
      "title": "迪希雅的爱好…",
      "desc": "我有空的时候，最喜欢打理我的「妆匣」。里面的香粉和粉刷可都是我花大价钱收来的，你瞧瞧这粉质，多细腻啊！不管是流了汗，还是淋了雨，妆都不会花。哼哼，真是一分钱一分货。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_pref_hobby",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/ef/f138o5q40dy81zv9x9akgvq3y46b41t.mp3"
    },
    {
      "title": "迪希雅的烦恼…",
      "desc": "又有几笔委托的钱款没结清，还有几个兄弟执行委托的时候闯了祸…唉，我明明不是团里的一把手，为什么还要操心这种事？",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_dialog_annoyed",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/cf/ou6xt70s5wqumnw8s08iawgmd2z8f88.mp3"
    },
    {
      "title": "喜欢的食物…",
      "desc": "那当然是「枣椰蜜糖」了，既容易携带，味道又好。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_pref_foodLike_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/15/dm2mq4xm41crgvbi255jk4c7yr2vu82.mp3"
    },
    {
      "title": "讨厌的食物…",
      "desc": "可别让我吃那种味道很苦的东西，我可受不了。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_pref_foodDislike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/ff/c4aigk6qizco704v74z3a6tvw8cwfxe.mp3"
    },
    {
      "title": "收到赠礼·其一",
      "desc": "这道菜味道真不错！再多吃几口的话，我说不定以后就吃不下那些干粮啦。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_spice_pref_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/70/rpwlxsbpudt5ch8otovsot9y9evo1mn.mp3"
    },
    {
      "title": "收到赠礼·其二",
      "desc": "唔，如果当做干粮来看的话，味道还是不错的。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_spice_normal_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/90/jf6ii19lx8ezk1emv0bx0om8yes8huu.mp3"
    },
    {
      "title": "收到赠礼·其三",
      "desc": "至少…至少能填饱肚子，能安全填饱肚子的食物就是好食物！哈哈…",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_spice_dislike_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b3/cu7ps9gyd6f688u3bzk9efyzsu44nsy.mp3"
    },
    {
      "title": "生日…",
      "desc": "生日快乐！摸摸你的兜，礼物已经放在里面了。怎么做到的？一点佣兵的小把戏而已。先别管这些了，我在兰巴德酒馆已经订了一桌上好的酒席，咱们赶紧过去吧。嗯？放心，我没有让团里的其他人过来，这帮人吵吵嚷嚷的只会起哄，好不容易过个生日，我来陪你就够了，走吧走吧。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_pref_birthday_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f6/bfoznmgfv6zur7wf1h00v6ak0jtxfst.mp3"
    },
    {
      "title": "突破的感受·起",
      "desc": "哦？力量真的在成长。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_starUp_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d9/8qq1ym1xynoupv9u53qpnoypb5lf1p0.mp3"
    },
    {
      "title": "突破的感受·承",
      "desc": "感觉不错啊，这样挥起剑来也更有力了。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_starUp_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/74/ok5tgl0vucgbqer0kgqbh6d9x4dd9aj.mp3"
    },
    {
      "title": "突破的感受·转",
      "desc": "这种力量…真想立刻去试试手，不然我们俩直接来过几招吧？",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_starUp_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/21/5wz7mzasnysg6ftqmqupr6gnjw50blu.mp3"
    },
    {
      "title": "突破的感受·合",
      "desc": "没想到我居然还能有这样的成长，这都多亏了你。接下来有什么委托吗？无论是什么委托，只要你开口，我就会和你同行。",
      "voicefile": "VO_friendship/VO_dehya/vo_dehya_starUp_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/56/ia0k5wbryuyaidxmg1au391jo45mazm.mp3"
    }
  ],
