  "hasLocalPack": false,
  "voicePackageUrl": "https://huggingface.co/datasets/simon3000/genshin-voice/resolve/main/speaker-archives/Chinese/501-plus/Yelan.zip",
  "voicePackageEn": "Yelan",
  "quoteCount": 71,
  "friendLines": [
    {
      "title": "初次见面…",
      "desc": "你好，旅行者，叫我夜兰就好。我想你或许会需要我的帮助，我恰好也对你所拥有的情报感兴趣。总之，让我们友好相处，互帮互助吧。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_draw_appear",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/ab/kthng1wgpyyj8he68tx8cp87791wv5l.mp3"
    },
    {
      "title": "闲聊·线报",
      "desc": "线人来信了，嗯，看来又出现了新的变数。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_character_idle_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/8f/0zrlm2nf7k6bsl06u14j2ik4jhpps00.mp3"
    },
    {
      "title": "闲聊·翘班",
      "desc": "点数不错，今天就继续翘班吧，等到状态好了，再去把活一次干完。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_character_idle_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d0/5htpzj3qn70sl1jvbsjupe6ptadxxar.mp3"
    },
    {
      "title": "闲聊·身份",
      "desc": "在这世间行走，「身份」多一点才便利。需要我帮你捏造一些吗？",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_character_idle_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fa/tqp70ue2uyg57qtb29067nocbaae6n0.mp3"
    },
    {
      "title": "下雨的时候…",
      "desc": "又下雨了？真是麻烦啊…痕迹一旦被雨水冲刷干净，就需要不少时间来还原了…",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_weather_heavyRain_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/7c/epp9ep1wooi0r50uwi6fl9z40ugxjj7.mp3"
    },
    {
      "title": "打雷的时候…",
      "desc": "在打雷时会感到害怕的，要么是纯真的孩子，要么是心虚之人。你应该两者都不算吧？",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_weather_thunder_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d9/s6mibq30ednbxwaz84xgm43ddz0rgae.mp3"
    },
    {
      "title": "下雪的时候…",
      "desc": "有点冷嘛…不能把外套披在肩上了。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_weather_snowy_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/03/3dz8vghj7tntufhxdtztw3xokesqe9l.mp3"
    },
    {
      "title": "阳光很好…",
      "desc": "刺眼的阳光，好烦人啊。这样一来，我可没法打盹了。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_weather_sunny_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/a2/n39tes8irst6kmqok2kzjzx87xtww8z.mp3"
    },
    {
      "title": "刮大风了…",
      "desc": "风里传来了躁动不安的情绪…嗯…",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_weather_gale_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/78/j7g69ofaojm8wg2pvynlhx0wak229x8.mp3"
    },
    {
      "title": "早上好…",
      "desc": "…嗯~这么早？没有必要的工作时，我习惯中午起床。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_dialog_greetingMorning",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/56/fiog6hmyiax8wdp4fmirhe83v13f8j7.mp3"
    },
    {
      "title": "中午好…",
      "desc": "啊，有点困了，小睡一会儿吧，不用提醒我，到了工作时间，我自然会醒的。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_dialog_greetingNoon",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c6/jok17yu1kkzzk0khtv702d1vb8dfdzx.mp3"
    },
    {
      "title": "晚上好…",
      "desc": "晚上好啊，晚饭吃了吗？吃了点什么？啊…我就随口问问，不要太在意。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_dialog_greetingNight",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/88/87qnoxb4rn5qs1o22y3bjbhwl2a3q3c.mp3"
    },
    {
      "title": "晚安…",
      "desc": "把牛奶喝了，乖乖睡吧。嗯？你说你不是小孩子？呵呵…那就放在这里，喝不喝随便你了。我的话，一般会在后半夜入睡。万一你有讲梦话的习惯，我不能保证不把它们记下来哦。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_dialog_greetingNight2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f1/b06rhsz0bo13zyc1bayt7gv22ob5m8i.mp3"
    },
    {
      "title": "关于夜兰自己·职责",
      "desc": "七星对璃月各地的情况了如指掌，但总有一些情报需要通过特殊手段去收集。我算是这方面的行家，所以这类差事基本被我包揽了。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_dialog_idle",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/0f/6t3cr7v86n4ilipko6ykenns41ehinf.mp3"
    },
    {
      "title": "关于夜兰自己·传闻",
      "desc": "有人说，岩上茶室的现任老板是个一夜暴富的年轻商人；有人说，总务司有位体虚多病的高等雇员，隐居在城外；还有人说，不要接近涉密地区，会被蓝色的鬼魂缠上…当然，大多普通人完全没听说过「夜兰」这个名字。所以你把那些传闻当成笑话听就好。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_dialog_idle2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/5b/jk5u9kvpnvj9gg3yco0zik6xal4y6of.mp3"
    },
    {
      "title": "关于我们·关系",
      "desc": "嗯？你那是什么表情？跟我相处不用这么警惕，我啊，从来不算计自己认可的人。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_dialog_close",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/7e/m09b8f171c1089h51gwtoiajc70goag.mp3"
    },
    {
      "title": "关于我们·欺骗",
      "desc": "别过分期待他人的「肺腑之言」，滑头鬼只会说你爱听的话；也别轻易迎接他人的目光，眼神最容易出卖一个人的情绪。我们怎么说都是朋友，要是你被人骗，我也会有种吃了哑巴亏的感觉呢。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_dialog_close1",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f2/ibbnhri0191kxpth2k4mfw0mmhp3ido.mp3"
    },
    {
      "title": "关于「神之眼」…",
      "desc": "重要情报所在的地点，往往隐藏着致命的杀机，无论有多少可靠的部下，都无法彻底排除风险，足够破局的武力才是关键。我还算走运，至少在悟出这个道理后几天，就获得了「神之眼」。否则，站在这里和你聊天的…就是蓬头垢面的鬼魂了。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_dialog_pendant",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/9c/ccojeb7x3cbj2xdwqvz4kg5e27zyebk.mp3"
    },
    {
      "title": "有什么想要分享·屏蔽噪音",
      "desc": "仔细打磨鳅鳅宝玉后，可以将它当成耳塞，隔音效果很不错，哪怕有人在你耳边嘶声哀嚎，都不会打扰你的美梦。当然，希望你以后不必用到这种东西。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_dialog_share_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c2/e1ihdfqvm46q3a70knbusprheakdd21.mp3"
    },
    {
      "title": "有什么想要分享·幽奇腕阑",
      "desc": "右手的镯子？告诉你也无妨…它蕴含着我们家族的术法，能传递简单的信息。至于信息的含义，都隐藏在这蓝光中，只有我能看懂。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_dialog_share_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/af/2b8oc2p75l2bey1wj2bmc9jtil7m9ms.mp3"
    },
    {
      "title": "有什么想要分享·追踪目标",
      "desc": "在追踪目标时，我一般倾向于给对方施加心理压力。在试图摆脱我的过程中，他们会阵脚大乱、搬救兵、改变计划…直到把自己的老底都交待出来。呵…",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_dialog_share_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/0d/gbv1ktptqjwxa793gfsgb3nrxa5qtw0.mp3"
    },
    {
      "title": "感兴趣的见闻…",
      "desc": "你了解盗宝鼬吗？它们的智力平平，但经过人为驯化后，也能熟练地重复偷盗，甚至开锁撬锁。多鲜活的例子啊——只要方法得当，连动物都能作为趁手的棋子，勾心斗角的人们又何尝不是如此？",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_pref_gift_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b3/gi857ydbsg3niyhes6hk0p3ficsi3j3.mp3"
    },
    {
      "title": "关于凝光·关系",
      "desc": "我跟凝光认识得早，那时她还不是七星，我们合作了一段时间。她能提前当上七星，说不定也有我的功劳。呵，谁知道呢？总之，现在这份工作是她推荐给我的。确实不错，很适合我。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_teammate_ningguang_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/59/pb1wash6j0ros7xkttzwegdrdcvpbl3.mp3"
    },
    {
      "title": "关于凝光·期待",
      "desc": "凝光是个不错的合作对象。不过我平日在外行走，得注意身份。总务司雇员见到七星，难免要尊称一声大人了。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_teammate_ningguang_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/23/mi19gu9e4275piu9stg7fhojig3thyv.mp3"
    },
    {
      "title": "关于甘雨…",
      "desc": "那位秘书啊…我不可能像她那样，时刻不停地工作。何况她的效率同样无可挑剔。半仙的血统大概给了她不少便捷吧，不用睡觉也能保持精力。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_teammate_ganyu_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/7f/ejs2g1fr8bcil2exoyrul20e1bh9t3b.mp3"
    },
    {
      "title": "关于刻晴…",
      "desc": "我不太喜欢把日程排得很满的人，他们没有给自己留下调整的余地，只要碰上意外，就会手忙脚乱，连累同僚。但「玉衡」不同，她总是有条不紊地办事，每次与她共事，都令我相当愉快。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_teammate_keqing_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b7/n64sk9zptesk0z7r5pjukvy9bikx0j6.mp3"
    },
    {
      "title": "关于烟绯…",
      "desc": "烟绯啊，我还挺喜欢她的。不谈以前的交情，作为鼎鼎有名的律法咨询师，她是璃月港内诸多情报的交汇点。每次帮她搞定麻烦，我都能顺带收获珍贵的线索。但她似乎对我有些敬重过度了。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_teammate_yanfei_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d1/dqfvbjyxiwzql18b9ivbhfcz3k06nsd.mp3"
    },
    {
      "title": "关于魈…",
      "desc": "家族的长辈们曾说，要对「护法夜叉」保持最大的敬畏。据说我那疯疯癫癫的先祖路过望舒客栈时，都会少见地安分下来，想必是被他那驱除邪祟的威压给照顾了。但若是有一天，我有幸与那位「降魔大圣」并肩作战，我还是会以任务为重，不可能因为他的身份而有所顾忌。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_teammate_xiao_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/ca/32l6ipl6h9ud7um5ibo228e0mdixpda.mp3"
    },
    {
      "title": "关于香菱…",
      "desc": "香菱啊，讨人喜欢的小厨师，挑选食材的标准完全不输琉璃亭和新月轩。有时我会去她那里买些风干后的绝云椒椒。她似乎不理解我吃辣的方式，我也不想和她解释，这是家族的传统。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_teammate_xiangling_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/71/15xcjkg600xd1j84rh02wo3e1a0hz7g.mp3"
    },
    {
      "title": "关于行秋…",
      "desc": "我当然记得他，飞云商会家的小少爷。我经常和他们家来往。也许以后，他也会成为眼观六路的能人呢？",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_teammate_xingqiu_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/01/19ie5qoyoprjecj5mddsg1mha78mcn1.mp3"
    },
    {
      "title": "关于达达利亚…",
      "desc": "那位愚人众的执行官？他在无意中给我带来了一些好处。我原本打算彻查「岩上茶室」的前任老板，但那位执行官下手更快，强硬地上门讨债，还公开了前任老板做的假账，让他获罪入狱。我也因此顺利接管了岩上茶室，得到了一个不错的据点。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_teammate_tartaglia_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/7a/bbqjdbzsmk4pbhulrowh0t86yrwx3lu.mp3"
    },
    {
      "title": "想要了解夜兰·其一",
      "desc": "愿意在你身上下注，是考虑到你身份特殊，应当能为我找来不少通往「真相」的线索。呵，今天带来什么消息了吗？",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_friendship_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/62/btyu6kqpze5lwxowl7bssvwjb9m8msk.mp3"
    },
    {
      "title": "想要了解夜兰·其二",
      "desc": "交换情报讲究平等，和你讲些往事也无妨。托家族的福，我从千岩军的斥候那里学到了一些本事，挺早就入行了。虽然收集情报的过程会受到各种阻挠，但只要丢不掉性命，最后的赢家，总归是我…",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_friendship_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/05/9nl32bzwfc8l4po33pnx7akrz32tpwi.mp3"
    },
    {
      "title": "想要了解夜兰·其三",
      "desc": "线索是一环扣一环的，沿着它们不断追查到一切的根源，才算是个了结。为此，我有必要将耳目散布到各行各业去。在这个过程中，难免就要扮演各种角色。有些人形容我「一人千面」，这种说法，我就当成夸奖收下了。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_friendship_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/58/4gbhpsxgf0njj88l12odng8hd33t5ez.mp3"
    },
    {
      "title": "想要了解夜兰·其四",
      "desc": "有人告诫过我，贸然探查某些往事，有可能惹来杀身之祸。呵，我可不想停下，更不会因为别人的话就停下。哪怕无法改变事实，我也绝不能待在迷雾中。你呢？你的选择会是什么？",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_friendship_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/2e/sdyg2klfvrqklze5bpf0ebv9tkx96qn.mp3"
    },
    {
      "title": "想要了解夜兰·其五",
      "desc": "说起来，你希望陪伴在你身边的我，是怎样的人？普通的合作对象？磨砺你的竞争对手？众多泛泛之交中的一位…还是说…重要的伙伴？依你的期望和态度，我可以「扮演」或「成为」他们中的任何人。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_friendship_05",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/18/47nfx8qzm9u8p4zaru1g0xtuo61tgwk.mp3"
    },
    {
      "title": "夜兰的爱好…",
      "desc": "闲暇之时，我会随机安排生活。方法很简单：列一张清单，投骰子来决定接下来要做的事。这种消遣能带来意想不到的乐趣，还能让我拓宽思维的边界，对于我的本职工作而言，也算有不小的帮助。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_pref_hobby",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/2f/qrj33fzaxtemjqwi5mxjn57vufybr69.mp3"
    },
    {
      "title": "夜兰的烦恼…",
      "desc": "相较于一些武人，我的体能其实不算太好，这是家族遗传的毛病。处理某些不能怠慢的工作前，我会调整作息，积蓄精力，争取一次完事收工。除此之外的时间里，我会尽量保持悠哉的节奏。所以，体力活我会谢绝的。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_dialog_annoyed",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/31/7nlhht6yvsxn3pvcjegtqv3ybdh806r.mp3"
    },
    {
      "title": "喜欢的食物…",
      "desc": "将风干后的绝云椒椒和琉璃袋的花蕊一同研磨成粉，均匀混合在云来白毫之中，沏一壶酽茶，它馥郁的香气必定会让你沉醉。相比咖啡和烈酒，我更偏好这种回味悠长的饮品。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_pref_foodLike_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/3d/3ssn34dxmhj1bnqx4env25je2q4749z.mp3"
    },
    {
      "title": "讨厌的食物…",
      "desc": "对于甜食，可得保持警惕啊。那种强烈的满足感…会削弱人的意志力，让人放松警惕。只要吃过几次，就有可能上瘾。长期吃甜食的人，或许会在不知不觉中变得迟钝吧。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_pref_foodDislike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fa/np56lo4w9kczuqy41exst08314t3rbe.mp3"
    },
    {
      "title": "收到赠礼·其一",
      "desc": "嗯，手艺不错，差点就要被你贿赂成功了。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_spice_pref_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/ed/kxpe0g6w6zmkjx88m994iqa3fz4mlyj.mp3"
    },
    {
      "title": "收到赠礼·其二",
      "desc": "吃惯辣味之后，其他菜总觉得不够劲。没办法啊。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_spice_normal_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/cb/945xzd8jtas2x3mxk3kq23kgliv2jbt.mp3"
    },
    {
      "title": "收到赠礼·其三",
      "desc": "投个骰子吧？点数比我小的话…就你来吃？",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_spice_dislike_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/80/08t7eiqxkap0tgikfw249yvq7rcx1vn.mp3"
    },
    {
      "title": "生日…",
      "desc": "要是在这种日子里，我还警告你「别因为庆祝而松懈，会被人趁机暗算」，可就太不解风情了。总之，今天你可以尽情放松。来「岩上茶室」坐坐，尝尝我为你特意准备的点心吧？当然，点心不甜，只是微微辣。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_pref_birthday_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/9e/38oqwt12owfuocqy1cv1v85cyblpsj1.mp3"
    },
    {
      "title": "突破的感受·起",
      "desc": "在我的工作中，战斗技巧从来不可或缺。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_starUp_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/ce/b635s7dl6k5oi0c0wu2acnjlf8itg8y.mp3"
    },
    {
      "title": "突破的感受·承",
      "desc": "唯有在必要时刻快准狠地出手，才能揭露某些谎言，排除沿途的干扰。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_starUp_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/ad/dlkmqfr9q70lee3z04k3zv10ea2qucs.mp3"
    },
    {
      "title": "突破的感受·转",
      "desc": "探索「真相」听来简单，实则需要长期咬住线索的毅力，还有深入险境的实力。",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_starUp_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4d/dmn73iv0aqjefx70o2q4eht6g1pdtup.mp3"
    },
    {
      "title": "突破的感受·合",
      "desc": "我早已将你当成最为重要的线人。自然就要作好万全的准备，迎接你为我带来终极答案时附带的风险。走吧，我们去把它拿下！",
      "voicefile": "VO_friendship/VO_yelan/vo_yelan_starUp_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/33/amjfbnyzmxjg5ls3bxts0j92td2rg0y.mp3"
    }
  ],
