  "quoteCount": 71,
  "friendLines": [
    {
      "title": "初次见面…",
      "desc": "稻妻神里流太刀术皆传——神里绫华，参上！\n请多指教哦。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_draw_appear",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/51/hx23f7cf96qrxdedj1x8km0ksmc8fwq.mp3"
    },
    {
      "title": "闲聊·安定",
      "desc": "像这样悠闲安稳的时光，如果再多一点就好了…我真贪心啊。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_character_idle_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/9f/7kwsl2vayi2nytjy22wyiyfew4n8vms.mp3"
    },
    {
      "title": "闲聊·剑",
      "desc": "剑，就和茶一样，细细品味才能理解其中风雅。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_character_idle_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/7d/3bwelz8qjime0dt5ymnzzdsdw1t5azo.mp3"
    },
    {
      "title": "闲聊·出神",
      "desc": "这就是旅行者平日里的生活么，呵，感觉又多了解了你一些。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_character_idle_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/7c/a66674bn9e8l969x8xduthw1y0t86he.mp3"
    },
    {
      "title": "闲聊·名刀",
      "desc": "刀剑抱业，名工怀宝。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_character_idle_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/02/kax4y0sz4rieq9gkfpjhswd8yppur5e.mp3"
    },
    {
      "title": "下雨的时候…",
      "desc": "请随我一同避雨吧。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_weather_heavyRain_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/aa/8gc62y4pq83a4v0q0yl50vtojuu0ooj.mp3"
    },
    {
      "title": "打雷的时候…",
      "desc": "大御所大人…是在诉说什么吗？",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_weather_thunder_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/26/7lb662maeg02ag962hgqbmmm9qe95eq.mp3"
    },
    {
      "title": "下雪的时候…",
      "desc": "「雪霁银妆素，桔高映琼枝。」嗯…美景当前，只差一壶茶与之相衬呢。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_weather_snowy_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/87/g29plqd4oog40q9zuqjdo6xs3gn8nvj.mp3"
    },
    {
      "title": "阳光很好…",
      "desc": "风和日丽，要去哪边走走么？",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_weather_sunny_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e4/ncmp19dsqi60p6qxjhe9ijtdb4ymovy.mp3"
    },
    {
      "title": "起风的时候…",
      "desc": "闭上眼睛，向着风吹来的方向…怎么样，很舒服吧？",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_weather_breezy_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/17/dyafdqnidsysxpalqkmv5nan1946xnj.mp3"
    },
    {
      "title": "早上好…",
      "desc": "早安，旅行者。能像这样在清晨见你一面，我会忍不住觉得…接下来将是顺利的一天。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_dialog_greetingMorning",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/13/233tm8l2llrm8715td7mytw84xka0cl.mp3"
    },
    {
      "title": "中午好…",
      "desc": "午安。茶饭之后，难免略有困倦。是否有兴致下盘棋提神呢？",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_dialog_greetingNoon",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/0e/pmngvml7kky0klfb6atyrp6dy2k9189.mp3"
    },
    {
      "title": "晚上好…",
      "desc": "晚上好。夜风舒畅，会是一个良宵呢。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_dialog_greetingNight",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d5/e1l9olkycvygzaq4xq6quvmij7dmvt2.mp3"
    },
    {
      "title": "晚安…",
      "desc": "「若知是梦何须醒，不比真如一相会。」",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_dialog_greetingNight2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e8/bumvqekdtayxkqo6l4ikwp3logvfglf.mp3"
    },
    {
      "title": "关于绫华自己·社奉行",
      "desc": "「稻妻幕府社奉行神里家」，位于稻妻名门中的笔头之格位。作为三奉行之一，掌管祭祀活动与人文艺术。自从双亲过世之后，族内的大小事务，便由兄长和我承担了。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_dialog_idle_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fa/3z54iju1g2rxiun9uv5qr655rr1p9k0.mp3"
    },
    {
      "title": "关于绫华自己·地位",
      "desc": "很多人因为我是「白鹭公主」，是社奉行神里家的大小姐而敬重我。他们所敬重的，只是我所身处的地位，与绫华我是怎样的人并无关系…\n所以我想，能真正走近我的，或许只有…",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_dialog_idle_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/22/64u4tlnnjlwa6px87hg2a6xw55s1ljy.mp3"
    },
    {
      "title": "关于绫华自己·愿望",
      "desc": "如今的我，依旧想成为值得大家信任的人。不过，鼓舞我的原因，已不再是肩上的责任或他人的期待。而是因为，你也是这样的人啊。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_dialog_idle_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b5/71jg1gypyxt0v597mjx824jf04v35wc.mp3"
    },
    {
      "title": "关于我们·茶室",
      "desc": "如你有空，我们移步木漏茶室如何？在这样恬静的日子，略加交流茶艺心得，想来是颇具雅趣的。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_dialog_close1",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/71/t9wpw6mhysjxujrt4pr150pg4xhg7x2.mp3"
    },
    {
      "title": "关于我们·节日",
      "desc": "如果有机会的话，我想试着和你共度异国的节日。需要遵循的当地风俗、礼仪规范，还有伴手礼的推荐，可以麻烦你…一一指导我吗？",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_dialog_close2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/6f/2ncqg5f7nps8tov37n70386a5g3trwo.mp3"
    },
    {
      "title": "关于「神之眼」…",
      "desc": "「神之眼」，即是胸怀大志之人所获的印绶。如果问我有什么志向的话…这个还是保密吧，只是一个微不足道的梦想罢了。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_dialog_pendant",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/54/sytnludv7619ofyyvxyy29606pbutas.mp3"
    },
    {
      "title": "有什么想要分享…",
      "desc": "试问，常说「禅茶一味」，又说「剑禅一如」，那么剑和茶，又是什么关系呢？",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_dialog_share",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/7b/cuoolfa2qj105m5qnylkwp0953pvmkj.mp3"
    },
    {
      "title": "感兴趣的见闻…",
      "desc": "你在城中，见过枯萎的樱花树么？这种「枯」之美，让我想到春天盛开之景。不过别人似乎并不这么想，不再开花的樱树会被移走…就算一次也好，真想看到它再次开放。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_pref_gift",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/44/otv5972qux89fng8my60mllzhsvhq05.mp3"
    },
    {
      "title": "关于托马…",
      "desc": "托马是我很重要的朋友，他的开朗和阳光总是感染着我。某种意义上来说，他就像是我的另一个兄长一样，已经成为了「神里家」的一员。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_teammate_thoma_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/3e/b1sz179h5vyuajlopnl8d9a7o14go5s.mp3"
    },
    {
      "title": "关于九条裟罗…",
      "desc": "为「天领奉行」工作的九条裟罗…她总是一脸严肃。我和她曾经起过几次争端，不过她本质是忠义之士，这点无可否认。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_teammate_kujouSara_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/75/941xu7srpl2cqdjfrzsgyt7dpzbi3ss.mp3"
    },
    {
      "title": "关于鹿野院平藏…",
      "desc": "鹿野院先生？他和九条小姐一样，是「天领奉行」的人。他…也是一个很有原则的人。对于这些「原则」的坚持，甚至比九条小姐更执着。只不过，什么事应该被算在这些「原则」之内，我想，或许只有鹿野院先生自己知道吧。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_teammate_shikanoinHeizou_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/5f/jgzpauri5ycsyxku5dyc17aq4w7v6n2.mp3"
    },
    {
      "title": "关于早柚…",
      "desc": "早柚这孩子，最近有没有给你添什么麻烦呢？如果看见她偷懒，可以直接告诉我。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_teammate_sayu_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d6/251e3ern60mhyhktz4dxinoc1fvwivs.mp3"
    },
    {
      "title": "关于雷电将军·猜测",
      "desc": "对大御所大人的看法吗？这并不该由我等下属随意议论。但…将军大人她，在追求「永恒」之路上，可能也很孤独吧。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_teammate_raidenShogun_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/7c/6dutgk05epbi41i2nx2hqlbloco0376.mp3"
    },
    {
      "title": "关于雷电将军·立场",
      "desc": "见证了「无想的一刀」并且活了下来，该说是堪称伟业的经历了吧。虽然对我来说，她是真正的神明，一念之间可以更改稻妻的命运，但如果是和你起了冲突的话…我一定会站在你这一边的。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_teammate_raidenShogun_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b6/260ruhwkzbp92lp5hn2seddr9doqrw6.mp3"
    },
    {
      "title": "关于八重神子…",
      "desc": "我和八重宫司大人的合作向来很愉快。你看，操办节庆庆典非常劳神费力，营收多半也不好看。但是八重宫司大人操办的产业，真的既风雅又有收成。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_teammate_yaeMiko_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f7/1d47jiivtyvxz9dgrjsqivvhney560m.mp3"
    },
    {
      "title": "关于神里绫人…",
      "desc": "作为神里家的家主，兄长平日需要出面诸多场合。我虽尽力分担兄长肩上所负担的责任，却也无法缓和他常年积压在身的疲倦。唉，就当是为了妹妹着想，希望你能劝言，让兄长多多注意身体啊。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_teammate_ayato_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f5/j145q8zqq88b7nrkp246xqq1lrnlpqy.mp3"
    },
    {
      "title": "关于宵宫…",
      "desc": "操办节庆庆典是社奉行和巫女众的责任，那位烟火专家也的确能让气氛热烈起来，彼此合作多了，因而渐渐熟络。\n嗯？治安和消防问题吗？我们也会一并纳入预先规划的。因为这些原因而看不到烟花，才会让人们心中留下缺憾吧。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_teammate_yoimiya_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/45/eg0d02enu7l7br9y4rpj7i33gr0vri6.mp3"
    },
    {
      "title": "想要了解绫华·其一",
      "desc": "你的请求，对我来说很特别呢。既然把你当做朋友，我也应坦诚以待。不过，事关神里家的秘密，还希望你能守口如瓶。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_friendship_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/33/h7zjlwgz7cqe0agq1prw0kz49ajapqk.mp3"
    },
    {
      "title": "想要了解绫华·其二",
      "desc": "曾经，神里家因为没能保护好国宝级别的刀工，遭受了不小的冲击。受愚人众阴谋算计，我们折损了诸多臣下，受到许多责罚。父亲甚至因之早衰，神里家在幕府中的地位也一落千丈…好在兄长继任后力挽狂澜。不过，家门虽已复兴，社奉行一系也上下齐心，但大事要事方面，仍靠兄长定夺。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_friendship_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/7a/j2qe8iavuygj32llhgrwswftee23ylw.mp3"
    },
    {
      "title": "想要了解绫华·其三",
      "desc": "将军所传的锻刀之术，也因星象、用途、矿质、炉火环境、人之性格、元素变化的不同，而有所区分。即是刀工之间所说的「雷电五传」。能锻造名刀的刀工，也被算作是本领通神的神事相关人员，归属统筹文化、艺术、祭祀的社奉行一派管理。因此，出现了刀工背叛的事情，自然就是神里家的督办不力了。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_friendship_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/64/f4pt09re141jw2tnsqhvv0h6xxubdlv.mp3"
    },
    {
      "title": "想要了解绫华·其四",
      "desc": "对我来说，母亲是意义非凡的存在。端庄、优雅，无论遇到怎样的局面都会露出沉静的笑容，以从容不迫的态度，操持着神里家大大小小的事务，说母亲是完美的化身也不为过。但自从她离世的那一刻起，我就深切地意识到，我已经不是那个可以躲在母亲身后的小绫华了。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_friendship_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4a/j6yjcf2crs9v1gjevkrvni379mssuij.mp3"
    },
    {
      "title": "想要了解绫华·其五",
      "desc": "接下来要说的话，可能不太符合「稻妻幕府社奉行神里家」的身份。不过，就我的判断，你应该能容许我小小的任性吧？\n…稍微有点累了…可以让我靠一下你的肩膀吗？一下就好。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_friendship_05",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/0f/2jmn4l10toopvd184873ve15bq1jw8t.mp3"
    },
    {
      "title": "绫华的爱好…",
      "desc": "风雅之物我都很喜欢：雅乐诗词、棋艺与舞蹈。你也感兴趣吗？",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_pref_hobby",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/2c/m9ikk8jes3efu6nts4gdpr1onmjpyjq.mp3"
    },
    {
      "title": "绫华的烦恼·忧虑",
      "desc": "烦恼吗？啊，是啊。只要生活在这个世界上，就难免遇到种种不如意的事情。但如果是因为自己的事情，就让周遭的人担心的话…果然，我还是不能说…",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_dialog_annoyed_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/95/ofhb67rksdyfb9j3j9thu6u88443rpz.mp3"
    },
    {
      "title": "绫华的烦恼·心意",
      "desc": "「坦率」，真的是一件很难的事情。我必须不断告诫自己是神里家的大小姐，在无数双眼睛，无数人的期盼之下摆出完美无缺的姿态。这样的我，是否也该追求自己的愿望呢，是否也该…让你理解我的心意呢…",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_dialog_annoyed_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/5c/cp6x9ig742obw7txurq48llreu2m55v.mp3"
    },
    {
      "title": "喜欢的食物…",
      "desc": "我对异国料理很有兴趣，虽然很少有尝试的机会。嗯…如果是要局限在稻妻料理内的话…应该是「茶泡饭」吧。不过，不能给一般客人看见，我也是偷偷告诉你的。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_pref_foodLike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c5/5vj4pffea67endt9lqi2qg0l4k8xvpp.mp3"
    },
    {
      "title": "讨厌的食物…",
      "desc": "虽然不是不能吃，但我对动物脂肪或内脏大概会有点…",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_pref_foodDislike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d9/r2sc2gvmprp4d4ovorycbf5w6kb2gcf.mp3"
    },
    {
      "title": "收到赠礼·其一",
      "desc": "嗯…我真是太幸福了…",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_spice_pref_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fa/b9smfhc00ag3nv4mpbwpvwwkizr1eta.mp3"
    },
    {
      "title": "收到赠礼·其二",
      "desc": "谢谢你让我有机会尝试这道菜，我会把它的味道记在心里的。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_spice_normal_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4e/9w9v8h5qupucjdlmxkmz5rckxhoxi1k.mp3"
    },
    {
      "title": "收到赠礼·其三",
      "desc": "啊…稍微有点油腻了呢。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_spice_dislike_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/81/gd3dlstqa40jbv0u7lkakjlfr5rk069.mp3"
    },
    {
      "title": "生日…",
      "desc": "请随我来！只要走一小段路，不会耽搁你太长时间的哦。\n打听到你的生日之后，我就提前了一段时间开始筹备。比起名贵的礼物，我妄自猜测…或许这样的礼物会更合我们的情谊。此次，就请让我以扇舞为礼吧。\n那么，失礼了。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_pref_birthday",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/01/awxes3apkaegwp420aaiql3us005uql.mp3"
    },
    {
      "title": "突破的感受·起",
      "desc": "非常感谢。与你切磋使我受益良多，相信在剑术上也能更进一步。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_starUp_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fa/m6yam85nn3kzo6a4xy88wx17py8c63n.mp3"
    },
    {
      "title": "突破的感受·承",
      "desc": "多亏你的点拨。有你相助，我对自己的能力也理解得更透彻了。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_starUp_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/82/1l5h36qwsl33w4392g6l6o9j9lmu2yt.mp3"
    },
    {
      "title": "突破的感受·转",
      "desc": "感觉更加游刃有余了。处理社奉行事务之余，甚至有空尝试一些新的事情。要来试试最近学做的点心吗？",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_starUp_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/83/d1sp4nakrezjnpx6irq2f00lurlgyby.mp3"
    },
    {
      "title": "突破的感受·合",
      "desc": "「尝有所思，斯世如磐；孰料浮世事，留驻难。」\n…抱歉，明明是值得高兴的时候，我却想起了那么悲伤的诗歌。和你相处的时间过于畅怀，竟然让我害怕再次失去。真是…失态了呀。",
      "voicefile": "VO_friendship/VO_ayaka/vo_ayaka_starUp_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/cc/k8aroky8osmqpq83g42ew8l9ak8ejfc.mp3"
    }
  ],
