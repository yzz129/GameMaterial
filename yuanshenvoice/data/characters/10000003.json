  "voicePackageUrl": "https://huggingface.co/datasets/simon3000/genshin-voice/resolve/main/speaker-archives/Chinese/501-plus/Jean.zip",
  "voicePackageEn": "Jean",
  "quoteCount": 72,
  "friendLines": [
    {
      "title": "初次见面…",
      "desc": "「蒲公英骑士」，琴，申请入队。从今往后，我的荣誉与忠诚将与你同在！",
      "voicefile": "VO_friendship/VO_qin/vo_qin_draw_appear",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/1a/2fb1097nmz3pylf9rni0fs6l6g92xnm.ogg"
    },
    {
      "title": "闲聊·行动",
      "desc": "行动起来吧，我们不该在这里停留。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_explore_idle_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/ca/95nzgayut91h65z9pfx4477pori4x39.ogg"
    },
    {
      "title": "闲聊·骑士团",
      "desc": "骑士团的大家…有没有认真工作呢？",
      "voicefile": "VO_friendship/VO_qin/vo_qin_explore_idle_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/59/k8twhlwgawkdb49khjhqz689bao0jzz.ogg"
    },
    {
      "title": "闲聊·目标",
      "desc": "走吧，前往下一个目标！",
      "voicefile": "VO_friendship/VO_qin/vo_qin_explore_idle_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/76/qonauuqqkgqo8taj67l4olb2q87k5aj.ogg"
    },
    {
      "title": "下雨的时候…",
      "desc": "下雨也无法阻挡我的脚步。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_weather_heavyRain_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d6/74d46tghyjovt54vnummkucbbvexz01.ogg"
    },
    {
      "title": "雨过天晴…",
      "desc": "这样的天气，正适合行动。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_weather_afterRain_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f4/azvm3kfukpdb6v6c2lt75a17pa94l7x.ogg"
    },
    {
      "title": "下雪的时候…",
      "desc": "下雪了，要注意战靴的保养啊。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_weather_snowy_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/36/26nu9qiitlhjypyy4bbqp2okly0fuu7.ogg"
    },
    {
      "title": "起风的时候…",
      "desc": "舒适的天气。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_weather_breezy_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b0/mqyuguknlpx2qsmz8lw4pty821ja2bs.ogg"
    },
    {
      "title": "刮大风了…",
      "desc": "传说，那天也刮着罕见的大风…",
      "voicefile": "VO_friendship/VO_qin/vo_qin_weather_gale_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/98/mkerm4bizhm2m0uh690f039hbhbrkrg.ogg"
    },
    {
      "title": "早上好…",
      "desc": "「一日之计在于晨」，今天也请加油。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_dialog_greetingMorning",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/51/2ecid3q7y8gdhlit6swxyq0e0bwq3or.ogg"
    },
    {
      "title": "中午好…",
      "desc": "好，现在开始处理任务吧。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_dialog_greetingNoon",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d3/74lhzzgf3dij3q4ub4az99ghib4jntx.ogg"
    },
    {
      "title": "晚上好…",
      "desc": "看样子，差不多已经对咖啡免疫了。如果有什么替代品的话…问问丽莎好了。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_dialog_greetingNight",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/bc/ptoss8oumkyobqr8v1c5k3j7ahsvm2h.ogg"
    },
    {
      "title": "晚安…",
      "desc": "今日的修炼就到此为止，做得很棒，辛苦你了。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_dialog_greetingNight2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e1/ttlrk8o5lj52l65ssfnclv2bd0y37g3.ogg"
    },
    {
      "title": "关于琴自己…",
      "desc": "今天为了保护民众，把五座遗迹守卫斩成了碎片。唉，我还需要继续磨练自己…这么珍贵的文化遗产，下次应该尝试空手制服…",
      "voicefile": "VO_friendship/VO_qin/vo_qin_dialog_idle",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/9c/lid8wxu114cp7pkrp8o5ciuyhe0gp5l.ogg"
    },
    {
      "title": "关于我们·信条",
      "desc": "我会全力帮助你，当然，如果你的方向偏离了正义，我也会毫不犹豫地指出。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_dialog_close1",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/ee/hyyyf1k759bbwylm1f1baup2cmgoxhc.ogg"
    },
    {
      "title": "关于我们·誓言",
      "desc": "我以此剑起誓，必将胜利献给你。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_dialog_close2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/ca/ixoif9o14oiarbrnjh6ndjs1shczo2n.ogg"
    },
    {
      "title": "关于我们·任务",
      "desc": "任务可是不会自动完成的，但适当放松一下也好。今天就破例午休几分钟吧。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_dialog_close3",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/1e/lg4ln7panhjpcx5yf4bkiqm1nqogy7o.ogg"
    },
    {
      "title": "关于「神之眼」…",
      "desc": "「永护蒙德」是古恩希尔德家族的家训。每当驱动「神之眼」，我都会想起母亲、还有蒙德民众的期盼。为蒙德而战，为自由而战——我，在所不辞。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_dialog_pendant",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c8/ov49cq3w73fa0xupcn38uwbo8a3ecgw.ogg"
    },
    {
      "title": "有什么想要分享…",
      "desc": "我谨代表西风骑士团，向你为蒙德所做的一切致以谢意。还请你劳逸结合，量力而…怎么了，你突然笑了起来，我说了什么奇怪的话吗？",
      "voicefile": "VO_friendship/VO_qin/vo_qin_dialog_share",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c5/bktxz76k0h38d8s3366nfgj9djmc4d7.ogg"
    },
    {
      "title": "感兴趣的见闻…",
      "desc": "「蒲公英，蒲公英，跟风一起，到远方去吧。」…它乘上风，说不定连天空岛都能飞到呢。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_pref_gift",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/93/p9tfcno2cgb6q3yzym9dfbsjseoed4w.ogg"
    },
    {
      "title": "关于芭芭拉…",
      "desc": "芭芭拉非常努力，只不过有时过于勉强自己…嗯？问我为什么了解得这么清楚？因为西风教会也归属骑士团管辖。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_teammate_barbara_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/98/kazf7flbh3x73zjrbpciltzot349vt9.ogg"
    },
    {
      "title": "关于丽莎…",
      "desc": "丽莎，有她在的话，我会安心很多。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_teammate_lisa_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c7/gie2ufx480u7eto28fh6zult4l4u67y.ogg"
    },
    {
      "title": "关于安柏…",
      "desc": "安柏这段时间确实有所成长。希望有朝一日，她的事迹也会被吟游诗人传颂。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_teammate_ambor_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/3a/j42r2sga8ugo4zat5k1w7fmw30xcv67.ogg"
    },
    {
      "title": "关于凯亚…",
      "desc": "是吗…凯亚也向你提出建言了啊。他是一名优秀的西风骑士，这点毋庸置疑。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_teammate_kaeya_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/05/h7fjrd9zz4ax4x8bzxx9htzb9p3uvav.ogg"
    },
    {
      "title": "关于可莉…",
      "desc": "虽说玩乐是孩子的天性，但可莉中意的玩具却都是些危险品。让人难以放心。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_teammate_klee_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/97/8vw78l4q8z3at4qa09qh8evx1tebvfj.ogg"
    },
    {
      "title": "关于阿贝多…",
      "desc": "「天才」这种名词，或许正是为了阿贝多这样的人准备的吧。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_teammate_albedo_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f5/bbif1110kvmne8w64uqlbdcw3bdtn02.ogg"
    },
    {
      "title": "关于法尔伽…",
      "desc": "法尔伽大团长，他是西风骑士团的当代传奇。等到他凯旋归来的那一天，就请你亲自和他交谈吧。相信你也能从中受益。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_teammate_varka_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/66/49bppr2ut85twxnyb5oj2axiizh28o6.ogg"
    },
    {
      "title": "关于诺艾尔…",
      "desc": "诺艾尔，嗯…那个努力想要成为西风骑士的少女。她的内心仍有软弱之处，现在这个阶段，也许还不适合让她接触外界的凶险。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_teammate_noel_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b5/6hu73xl21oc2hba7qwmqbmitjexly57.ogg"
    },
    {
      "title": "关于罗莎莉亚…",
      "desc": "罗莎莉亚修女总是把「麻烦」挂在嘴边，实际却十分称职。上次我和她说「如果觉得麻烦也可以找我帮忙」，她却回答「这样更麻烦」。嗯…我果然还有很多欠缺啊。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_teammate_rosaria_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/08/5wbnp1r6ju8ji8vgpq2sv4t5zpymcvh.ogg"
    },
    {
      "title": "关于迪卢克·愧欠",
      "desc": "迪卢克前辈对骑士团的指摘事出有因，即使心中愧疚也无法改变既定的结果…我只想通过我的努力，让他对骑士团有所改观…嗯，这是我的责任。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_teammate_diluc_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/2e/42o10d1eehf1hkuket84m00baki7f5k.ogg"
    },
    {
      "title": "关于迪卢克·敬重",
      "desc": "迪卢克…是一位非常可敬的前辈。虽然我们选择的道路不同，但这份共通的守护蒙德的心意，我能感受得到。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_teammate_diluc_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fb/iakiesy0ellcnlgyw15p8s9qn6j1nhl.ogg"
    },
    {
      "title": "关于砂糖…",
      "desc": "作为炼金术士，砂糖也算天赋异禀。况且她的身边还有阿贝多指点，未来应该不用担心。只是…不，没什么，沉浸在自己的世界里，也不算坏事吧。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_teammate_sucrose_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/85/m93h448btdjlpqzrwx2w1rojfph3b2j.ogg"
    },
    {
      "title": "关于优菈…",
      "desc": "优菈？咳…请不要对她的身世耿耿于怀，西风骑士会公正地评价每个人。优菈明辨是非，才华出众，偶尔发表危险言论，也只是她的性格使然。哪怕她总是说要挑战我，我也不介意。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_teammate_eula_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/63/643tkn3tpqujfdtfrmwl6vb0yy8j5rp.ogg"
    },
    {
      "title": "关于米卡…",
      "desc": "大团长选中米卡作为远征队的前侦骨干，不仅是出于任务需要，更是看中了他踏实勤恳的品质。从我个人角度而言，我也很荣幸能与这样的同伴共事。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_teammate_mika_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/7/75/VO_ZH_Jean_About_Mika.ogg"
    },
    {
      "title": "想要了解琴·其一",
      "desc": "我肩负着西风骑士团的信任，还有蒙德民众的期待。为此，我不能松懈。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_friendship_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/63/643tkn3tpqujfdtfrmwl6vb0yy8j5rp.ogg"
    },
    {
      "title": "想要了解琴·其二",
      "desc": "温妮莎的「蒲公英骑士」之名传承至今，曾经有无数伟大的骑士获授这一荣誉。我不能辱没这个名字。因此，决不能松懈。要成为守护众人的坚盾与利剑。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_friendship_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b4/1xittnjje9j4n9vitoc7jn69sqxynwf.ogg"
    },
    {
      "title": "想要了解琴·其三",
      "desc": "无论是传奇故事还是史书，都只记载了伟大骑士的功绩。难道，他们一次也不曾迷失过吗…？\n风啊，请指引我前进的道路。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_friendship_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b1/hbdg79v0e3ueoe6pgcmrii7d429ngnb.ogg"
    },
    {
      "title": "想要了解琴·其四",
      "desc": "全身心投入工作的时候，烦恼和时间会一并被忘却。「你是最适合做这种事情的人选。」…那个时候，大团长法尔伽就是这样对我说的。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_friendship_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/1a/ngxwixu3txegbfpb7cqtm0uf174feke.ogg"
    },
    {
      "title": "想要了解琴·其五",
      "desc": "与你同行时，前进的道路变得无比清晰。就好像，终于有人能依靠，这究竟是…\n不，一定是我还不够努力。绝对不能松懈，不能辜负西风骑士团和蒙德…但是，谢谢你。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_friendship_05",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/43/60iasnbsc2rji4e2bu52uydwzfltppa.ogg"
    },
    {
      "title": "琴的爱好…",
      "desc": "或许可以和你聊聊书上那些英雄传记。嗯，你听说过「坎瑞亚英雄王」的故事吗？",
      "voicefile": "VO_friendship/VO_qin/vo_qin_pref_hobby",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e5/bo1ckjgy55jd9jqgg4xatzsl9i3mgod.ogg"
    },
    {
      "title": "琴的烦恼…",
      "desc": "假如有什么神奇的药剂，喝了就不需要睡觉…嗯，要不明天问问丽莎吧？",
      "voicefile": "VO_friendship/VO_qin/vo_qin_dialog_annoyed",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/30/9kfghmgem5a5izjg67w8f1ebt68rz40.ogg"
    },
    {
      "title": "喜欢的食物…",
      "desc": "猫尾酒馆的披萨…很久没吃过了。如果能外送到办公室就好了呢。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_pref_foodLike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/68/j9xxa7egofv5mfzxoudelz777hftfmc.ogg"
    },
    {
      "title": "讨厌的食物…",
      "desc": "优秀的骑士不能挑食。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_pref_foodDislike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/33/gstpevg2v9xpsptfuangu6192ygcyh4.ogg"
    },
    {
      "title": "收到赠礼·其一",
      "desc": "不仅味道好，还兼顾了健康。让你费心了。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_spice_pref_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d6/bd0onu8d406buy13h6whhn6shy23ljp.ogg"
    },
    {
      "title": "收到赠礼·其二",
      "desc": "嗯，精神振奋不少。谢谢你。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_spice_normal_01",
      "localAudio": null,
