  "cv": {
    "chinese": "林簌",
    "japanese": "斋藤千和",
    "english": "斯蒂芬妮·萨瑟兰",
    "korean": "安荣美"
  },
  "avatarImg": "assets/characters/10000003-avatar.webp",
