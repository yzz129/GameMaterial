    },
    {
      "title": "收到赠礼·其三",
      "desc": "呼…总之，辛苦你了。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_spice_dislike_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/1/1e/VO_ZH_Jean_Receiving_a_Gift_-_03.ogg"
    },
    {
      "title": "生日…",
      "desc": "今天是值得庆祝的日子。要说为何的话，因为这是受风护佑的你，诞生的日子啊。既然是生日，那就好好休息一下吧。\n咳咳…祝你生日快乐…\n啊，请原谅我的冒昧。不知这份礼物，是否能令你满意呢？",
      "voicefile": "VO_friendship/VO_qin/vo_qin_pref_birthday",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d6/bd0onu8d406buy13h6whhn6shy23ljp.ogg"
    },
    {
      "title": "突破的感受·起",
      "desc": "好，一鼓作气前往下一个目标。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_starUp_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/0d/9my1le0ilcfj4mc6rtn61mpt3xysg3c.ogg"
    },
    {
      "title": "突破的感受·承",
      "desc": "只要风不停歇，我就不会停下脚步。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_starUp_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/37/f9o4cgc8b3d848jmnpj6wj76hi9yor4.ogg"
    },
    {
      "title": "突破的感受·转",
      "desc": "就算暂时获得了平静，也不能掉以轻心。身为代理团长，我必须未雨绸缪。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_starUp_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/da/0ttylynt4jw1j9y3fs06yromoqi2y86.ogg"
    },
    {
      "title": "突破的感受·合",
      "desc": "我做得还不够好。自从与你相遇，一直承蒙你的关照。这份感激…\n风啊，请容许我的私心。并非作为代理团长，只是作为「琴」，在此起誓——我的剑将与你同在。",
      "voicefile": "VO_friendship/VO_qin/vo_qin_starUp_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/2b/2o3ojkvrpyurzcg5sjtk8b2j5h9kocj.ogg"
    }
  ],
