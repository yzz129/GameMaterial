  "quoteCount": 66,
  "friendLines": [
    {
      "title": "初次见面…",
      "desc": "你的气味…好闻。一起狩猎吧！",
      "voicefile": "VO_friendship/VO_razor/vo_razor_draw_appear",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/9d/9chg9rudcgh01p75sq4l9ibsckqwgqk.ogg"
    },
    {
      "title": "闲聊·气味",
      "desc": "唔，兔子的味道…",
      "voicefile": "VO_friendship/VO_razor/vo_razor_explore_idle_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/9d/9chg9rudcgh01p75sq4l9ibsckqwgqk.ogg"
    },
    {
      "title": "闲聊·饿",
      "desc": "走吗，肚子饿了。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_explore_idle_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/52/1uhjjyouclnl3xm8rwn6314eyub9vp8.ogg"
    },
    {
      "title": "闲聊·望风",
      "desc": "我去望风，走了叫我。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_explore_idle_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/1b/oa8216ysxo92loknl59olt5q8zoaprg.ogg"
    },
    {
      "title": "打雷的时候·提醒",
      "desc": "怕就快点躲起来。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_weather_thunder_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c9/1k7zb0usb48cm6bgs8r2j5onrop3kuc.ogg"
    },
    {
      "title": "打雷的时候·带路",
      "desc": "避开树，跟我来！",
      "voicefile": "VO_friendship/VO_razor/vo_razor_weather_thunder_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/8b/s3efv4twotfzrkwb4ekw7dfl9gvrxgl.ogg"
    },
    {
      "title": "起风的时候…",
      "desc": "风…唔…舒服。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_weather_breezy_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/99/ohj9fr985ccchgl3t4aeudmchywg60b.ogg"
    },
    {
      "title": "刮大风了…",
      "desc": "风…嗯…扎扎的，有点疼。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_weather_gale_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/45/bdc97tb0aas3fx8zba2jowd0vjy07pb.ogg"
    },
    {
      "title": "早上好…",
      "desc": "太阳出来了。狩猎一起去？",
      "voicefile": "VO_friendship/VO_razor/vo_razor_dialog_greetingMorning",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/20/t3ggtt348dlvi8jnri52922szfvyp20.ogg"
    },
    {
      "title": "中午好…",
      "desc": "大块吃肉，开心！",
      "voicefile": "VO_friendship/VO_razor/vo_razor_dialog_greetingNoon",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/6f/1foeieavwzk2z71xmkiihn53i852t04.ogg"
    },
    {
      "title": "晚上好…",
      "desc": "你去睡觉吧，我看月亮。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_dialog_greetingNight",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/9f/l8kbh1tu8ez8ecesfq0qhvog9ibfyur.ogg"
    },
    {
      "title": "晚安…",
      "desc": "你睡觉，我看守。明天一起狩猎。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_dialog_greetingNight2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/dc/t00mxp8a6n6dxo7seqtio7wij3nmvam.ogg"
    },
    {
      "title": "关于雷泽自己…",
      "desc": "我是狼。人的爸爸、妈妈，没有。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_dialog_idle",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/0b/nk6nmhgwx7lb80usk3qpfh51g03d50c.ogg"
    },
    {
      "title": "关于我们·朋友",
      "desc": "你是朋友。我和你一起狩猎。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_dialog_close1",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/67/sdl5fx7r71xoxasnetcvk4ophnskrhx.ogg"
    },
    {
      "title": "关于我们·武器",
      "desc": "我有铁的爪子和雷的牙。我保护你。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_dialog_close2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/26/o9jaizm3lwi6fpx8x5hbrt9dyaegc28.ogg"
    },
    {
      "title": "关于「神之眼」…",
      "desc": "「神之眼」，师父帮忙。雷的牙打架，保护「卢皮卡」。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_dialog_pendant",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b7/aqokgmhx8xmc7l42m6vb7rwvn378hbv.ogg"
    },
    {
      "title": "有什么想要分享…",
      "desc": "晚上，星星很好看。天空，湖里，都有很多很多星星。\n晚上，城市里，也有很多星星。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_dialog_share",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e6/s8kenc14ben9tmb6e5w7yhw17foxake.ogg"
    },
    {
      "title": "感兴趣的见闻…",
      "desc": "我的「卢皮卡」的狼。它们是家人。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_pref_gift",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fb/hk83ac9ddlx35gxjl55nfc5us1g21v9.ogg"
    },
    {
      "title": "关于丽莎…",
      "desc": "师父的雷，天空会变黑。很可怕，很强。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_teammate_lisa_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/39/p5ssqsllq86cn1qpte03t37wk5ow84c.ogg"
    },
    {
      "title": "关于芭芭拉…",
      "desc": "芭芭拉，亮晶晶的女孩子。很善良。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_teammate_barbara_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/33/ltvoqx0cuw1fh1ckx94nccaonass33k.ogg"
    },
    {
      "title": "关于迪卢克…",
      "desc": "迪卢克，红红的、黑黑的。又冷又热。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_teammate_diluc_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c5/lsyv4u5tr3jzqoako6npl1iosp7ntnk.ogg"
    },
    {
      "title": "关于温迪…",
      "desc": "诗歌…唔，不明白。虽然不明白，「卢皮卡」喜欢。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_teammate_venti_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/8e/1lawjrjiw3gp5qvy9yxzqsvdmrwrict.ogg"
    },
    {
      "title": "关于班尼特…",
      "desc": "班尼特，话很多，和他一起，吃不饱。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_teammate_bennett_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/31/30u0stmlcguqj2lofmkrdlyfdyw5ncl.ogg"
    },
    {
      "title": "关于可莉…",
      "desc": "可莉，朋友！朋友，但是，头疼。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_teammate_klee_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4c/0gp7kllh442o98mhmlkdq8ptjef6wqk.ogg"
    },
    {
      "title": "关于法尔伽·陌生",
      "desc": "法尔伽？不认识…",
      "voicefile": "VO_friendship/VO_razor/vo_razor_teammate_varka_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/37/snypedxdalmvmgylre7n4wui820z9wq.ogg"
    },
    {
      "title": "关于法尔伽·回忆",
      "desc": "哦…法尔伽，是名字。那个男人，高大。雷泽名字，铁的爪子，他给的。唔…想见他。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_teammate_varka_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/9c/ockexv30udrdp425jjx79jf2bi53erm.ogg"
    },
    {
      "title": "想要了解雷泽·其一",
      "desc": "你的气味，善良的味道。喜欢吃肉？",
      "voicefile": "VO_friendship/VO_razor/vo_razor_friendship_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/90/g8ouc1zfn4dkfzvofwg3927cn1ru0o1.ogg"
    },
    {
      "title": "想要了解雷泽·其二",
      "desc": "你很强。和狼一样强。喜欢和你狩猎。收获很多。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_friendship_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/36/gulaultonqnavoem8biu81lwf9t2uac.ogg"
    },
    {
      "title": "想要了解雷泽·其三",
      "desc": "卢皮卡是「狼的家」。不对，是「狼的家人」。我的卢皮卡在树林里。它们保护我，说我是卢皮卡。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_friendship_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/93/aj45om23c9jva33wea7az1drseas5uk.ogg"
    },
    {
      "title": "想要了解雷泽·其四",
      "desc": "我只有卢皮卡。\n但是，就算是卢皮卡，我没有四只脚，不是真的狼。有时候心里难过。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_friendship_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/9a/7ccxtn4harfcvfzzngomtut85dm6hay.ogg"
    },
    {
      "title": "想要了解雷泽·其五",
      "desc": "和你一起奔跑开心，和你一起狩猎开心。和你一起，我是狼，我是人，都没关系。\n你是朋友，你是我的「卢皮卡」。我想要你也开心。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_friendship_05",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e0/rla4pqq4r1no4bt3ssr7g0fsnblbsqb.ogg"
    },
    {
      "title": "雷泽的爱好…",
      "desc": "喜欢卢皮卡。喜欢树林。喜欢朋友。喜欢奔跑。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_pref_hobby",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/20/12yv1er2m5f18vyjq1w91god6ej1lyc.ogg"
    },
    {
      "title": "雷泽的烦恼…",
      "desc": "说话很累，很难。但是，不说话不行。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_dialog_annoyed",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/67/1duag5il9fefvq65y2kfrcaatnq3bv1.ogg"
    },
    {
      "title": "喜欢的食物…",
      "desc": "喜欢肉。喜欢土豆。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_pref_foodLike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c6/fkseiz6139lkcpdf5ddm8u3ds0xvipv.ogg"
    },
    {
      "title": "讨厌的食物…",
      "desc": "蔬菜不好。我吃的肉才吃菜。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_pref_foodDislike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c6/89jlkv6t7kk0kf0by6ilp03ivei00ap.ogg"
    },
    {
      "title": "收到赠礼·其一",
      "desc": "气味很香，味道一样好。喜欢。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_spice_pref_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/76/aq5drtrblr1cwee5apitk7vat5wu2pz.ogg"
    },
    {
      "title": "收到赠礼·其二",
      "desc": "吃了有力气，很开心。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_spice_normal_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/6/66/VO_ZH_Razor_Receiving_a_Gift_-_02.ogg"
    },
    {
      "title": "收到赠礼·其三",
      "desc": "吃，不好。不吃，不好。有些难过。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_spice_dislike_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/5/5a/VO_ZH_Razor_Receiving_a_Gift_-_03.ogg"
    },
    {
      "title": "生日…",
      "desc": "今天是你的…你是在很多很多个月以前的，今天出生的。想和你一起开心。今天一起吃肉。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_pref_birthday",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/c/c6/VO_ZH_Razor_Birthday.ogg"
    },
    {
      "title": "突破的感受·起",
      "desc": "手臂，更粗了…？",
      "voicefile": "VO_friendship/VO_razor/vo_razor_starUp_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/76/aq5drtrblr1cwee5apitk7vat5wu2pz.ogg"
    },
    {
      "title": "突破的感受·承",
      "desc": "磨爪子，磨牙，要更强！",
      "voicefile": "VO_friendship/VO_razor/vo_razor_starUp_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/13/nnv8dvntb0cayz25bfdzdohybqy3flj.ogg"
    },
    {
      "title": "突破的感受·转",
      "desc": "跑，狩猎。不够，不行！我要…更强。",
      "voicefile": "VO_friendship/VO_razor/vo_razor_starUp_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/ea/k7yfoby0vla2a0dst00hfhyjqobm8ec.ogg"
    },
    {
      "title": "突破的感受·合",
      "desc": "牙齿，爪子，腿。更强，更有力气…保护你！",
      "voicefile": "VO_friendship/VO_razor/vo_razor_starUp_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/24/clhgberkj4eyc17a04shnvihv7ewsnq.ogg"
    }
  ],
