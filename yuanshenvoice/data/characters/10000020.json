      "desc": "啊！",
      "voicefile": "VO_gameplay/VO_razor/vo_razor_battle_skill1_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/22/h1lz3blocur1v4sinxecgg09iyfr9cd.ogg"
    },
    {
      "title": "元素战技·其三",
      "desc": "嗷！",
      "voicefile": "VO_gameplay/VO_razor/vo_razor_battle_skill1_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/86/b41gpjeeddpbmiwcabq2r418yn15k1c.ogg"
    },
    {
