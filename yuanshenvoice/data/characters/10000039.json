  "voicePackageEn": "Diona",
  "quoteCount": 80,
  "friendLines": [
    {
      "title": "初次见面…",
      "desc": "「猫尾酒馆」的招牌调酒师，迪奥娜，我的出场费可是很贵的。唔？你居然…不是为了酒才来的？哼，那你的邀请…我就勉为其难地接受了。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_draw_appear",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/3f/f032apxfqa231wdgb2ugupgntreo8zr.mp3"
    },
    {
      "title": "闲聊·放松",
      "desc": "哈~~好舒服，身体都变得更柔软了。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_explore_idle_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/32/osfkczlwkgr875oc481m6u87auloos1.mp3"
    },
    {
      "title": "闲聊·思考",
      "desc": "蜥蜴尾巴、胡椒、星螺…还差点什么才能调出「难喝到头脑炸裂的酒」呢？呜…",
      "voicefile": "VO_friendship/VO_diona/vo_diona_explore_idle_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f9/cmtlhojmt2zxsd58k0uu60aeq9t29rw.mp3"
    },
    {
      "title": "闲聊·等待",
      "desc": "才，才没有在等你。我只是，正好在休息而已！",
      "voicefile": "VO_friendship/VO_diona/vo_diona_explore_idle_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d3/gm5u1t9lph1stlf5m95q09azrgtp9rr.mp3"
    },
    {
      "title": "下雨的时候…",
      "desc": "呜呜…讨厌下雨…去屋子里吧。唔，只是因为弄干衣服很麻烦！才不是什么怕水呢！",
      "voicefile": "VO_friendship/VO_diona/vo_diona_weather_heavyRain_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/73/cf976qen6ngl0cvosedg4ji89kv5oxd.mp3"
    },
    {
      "title": "打雷的时候…",
      "desc": "欸？！…我没有在发抖！没有！…呜…",
      "voicefile": "VO_friendship/VO_diona/vo_diona_weather_thunder_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/aa/59lnsr6uop2wa9hfttg1wlq7603uisd.mp3"
    },
    {
      "title": "下雪的时候·玩雪",
      "desc": "这个凉飕飕的触感，哇…好棒，好有趣。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_weather_snowy_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/59/hxs9vjbsctc1p1te1qih7rov5g5qynw.mp3"
    },
    {
      "title": "下雪的时候·观雪",
      "desc": "白茫茫的雪在风里跳舞，真好看呢。嗯…我旁边的座位还空着，没人坐哦。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_weather_snowy_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b9/cib1vr0e1ckiackcvz1px6cxwzg26b7.mp3"
    },
    {
      "title": "阳光很好…",
      "desc": "走喽，晒太阳…你不去我可就自己去了哦…唔，最后一次机会！走不走！",
      "voicefile": "VO_friendship/VO_diona/vo_diona_weather_sunny_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b8/jubqwl5383fvj0im38sz9sh8isxzoe8.mp3"
    },
    {
      "title": "早上好…",
      "desc": "早，把橱柜里那罐腌泥鳅递给我一下——好咧，我要开始摧毁蒙德酒业啦。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_dialog_greetingMorning",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/96/kv8k421oecjs26sgl3x7spt8ogmmieq.mp3"
    },
    {
      "title": "中午好·异响",
      "desc": "咕噜噜…嗯？没有！你什么都没有听到！",
      "voicefile": "VO_friendship/VO_diona/vo_diona_dialog_greetingNoon2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/bb/pje17kti5e544a6v7jtgcr88exyemv2.mp3"
    },
    {
      "title": "中午好·罐头",
      "desc": "这个鱼肉罐头是我好不容易省下来的，别，别看啦！最多…最多只能给你尝一口。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_dialog_greetingNoon",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/09/ftl7eaqtoe7b3an1lu8gj293u4xmysg.mp3"
    },
    {
      "title": "晚上好…",
      "desc": "失败了…又失败了…大家都喝得好开心，呜…别安慰我，我才不需要安慰…",
      "voicefile": "VO_friendship/VO_diona/vo_diona_dialog_greetingNight",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/a9/ht6ceszgm0e5sh2z8j0nxxuez3qiozi.mp3"
    },
    {
      "title": "晚安…",
      "desc": "你没有猫的夜视能力，走夜路不要紧吧？要我护送你的话…欸，有灯啊？…谁，谁要护送你啦，快点走快点走。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_dialog_greetingNight2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d9/ov21pd48qteb774ij28qshu2h7f8059.mp3"
    },
    {
      "title": "关于迪奥娜自己…",
      "desc": "耳朵和尾巴才不是什么装饰，是「凯茨莱茵家族」血统的象征，真是少见多怪。呃…你、你把手伸过来干什么？这个…唔…好吧，耳朵的话可以让你摸一下…但是尾巴、尾巴绝对不可以！",
      "voicefile": "VO_friendship/VO_diona/vo_diona_dialog_idle",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/12/37z85dfpo8x27me0lhlc05l7kb7wvqz.mp3"
    },
    {
      "title": "关于我们·饮料",
      "desc": "想喝无酒精饮料？难倒是不难，但是没有意义！无论成功还是失败，都和摧毁蒙德酒业的目标没有关联。我才不会做呢。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_dialog_close",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/64/r5sbr7ff8w6edjusirrxghyy0fn0xcf.mp3"
    },
    {
      "title": "关于我们·贵宾渠道",
      "desc": "喏，这个是「了不起的夏日梦幻忧郁珊瑚气泡茶」，只是因为最近无聊才做的。热门产品？排队抢购？你在说什么呢，我可没听见。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_dialog_close1",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e9/tbq01klsifbro7fiug8atymfzr4id2p.ogg"
    },
    {
      "title": "关于我们·聊天需要",
      "desc": "唔…要是，要是你感觉孤单了，我可以随便陪你聊聊天。我还是知道很多事情的哦！也是很好的…那个叫什么，说话对象哦。没错没错！来跟我，多说说话吧…",
      "voicefile": "VO_friendship/VO_diona/vo_diona_dialog_close2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/8c/3iy18uo0m1co6hz0whx7ahb8r95hgub.ogg"
    },
    {
      "title": "关于我们·好奇心",
      "desc": "是什么是什么？你拿着的是什么？快给我看看！说不定丢到酒里能做出相当难喝的…啊，什么嘛，原来只是长得奇怪了点的蘑菇而已呀，真无趣。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_dialog_close3",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/ca/k5qncge5cukpx9ehbqr42qgsp0jlf0e.ogg"
    },
    {
      "title": "关于「神之眼」·遗传",
      "desc": "问我的「神之眼」是怎么来的？哼，是、呃…是凯茨莱茵的家族遗传！唔？杜拉夫先生根本没有神之眼？欸——露馅了。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_dialog_pendant_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fd/5v9va9dbddz19wg5vjsy9x1ycby5zxw.ogg"
    },
    {
      "title": "关于「神之眼」·来历",
      "desc": "为什么非得告诉你啦，哼！算了，看在你一直追问的份上，看在…看在我们是朋友的份上。那次我爸爸外出打猎，差点出大事，在大雨中，我脑袋里想的全部事情就是要找到他，救出他…好了啦，满意了吧！",
      "voicefile": "VO_friendship/VO_diona/vo_diona_dialog_pendant_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/97/su3zrdbk04gwi91ts6xlwdkqxtw09bw.mp3"
    },
    {
      "title": "有什么想要分享…",
      "desc": "龙脊雪山上，会不会长着奇珍异草呢。「拥有致命的苦味」或者「沾到一点就嘴巴发麻」这样？要拔好多下来！然后…嘿嘿嘿…嚯嚯。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_dialog_share",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/97/su3zrdbk04gwi91ts6xlwdkqxtw09bw.mp3"
    },
    {
      "title": "感兴趣的见闻…",
      "desc": "我扑…捕捉蝴蝶的技巧可是一流的。喂，不是啦！抓蝴蝶是为了加进酒里做出难吃的味道，不要把我当成猫啦！喵！",
      "voicefile": "VO_friendship/VO_diona/vo_diona_pref_gift",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e1/llzsynxg4l7jmz8hid4bt5v57ry30he.mp3"
    },
    {
      "title": "关于迪卢克…",
      "desc": "那个…迪卢克，是我最讨厌的人！没有迪卢克就不会有蒙德酒业，没有蒙德酒业爸爸就不会喝酒，爸爸不喝酒就…就会陪我了，哼。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_teammate_diluc_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/ef/lqflh6vya3c8sdt893cnc4992dboi4s.mp3"
    },
    {
      "title": "关于凯亚…",
      "desc": "为什么连我的「护卫队长」也是个令人讨厌的酒鬼啦！就是那个，说起话来总是笑盈盈的家伙！喝起酒来一杯接一杯的，没完没了。呼！",
      "voicefile": "VO_friendship/VO_diona/vo_diona_teammate_kaeya_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/79/qwjdjpaycmc2gr291x5bvkqj494rvhf.mp3"
    },
    {
      "title": "关于温迪…",
      "desc": "温迪？不太熟的样子。但说到吟游诗人，就是那伙会给酒鬼们唱歌助兴的人吧。那就不喜欢！不喜欢不喜欢。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_teammate_venti_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b6/qv477wpp9googesrlf22dobedg8oi8v.ogg"
    },
    {
      "title": "关于芭芭拉…",
      "desc": "芭芭拉小姐的粉丝们，都是大哥哥大姐姐…好羡慕，为什么我的粉丝都是一群大叔呢。呜…可恶，哼，不想了。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_teammate_barbara_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/60/tih53bxbsogs5re8y7qy5e10f1y03n8.mp3"
    },
    {
      "title": "关于琴…",
      "desc": "琴啊，骑士团的代理团长，嗯…难得一个不喝酒的成熟大人…但总感觉认真过了头，骑士团的大家对我有些过度保护了吧？",
      "voicefile": "VO_friendship/VO_diona/vo_diona_teammate_qin_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4a/mbwdn2fugvf23k0juq079tugyhgb7kr.mp3"
    },
    {
      "title": "关于阿贝多…",
      "desc": "首席炼金术士大人？唔…我这种一直调出好酒的体质，他会知道破解的方法么？",
      "voicefile": "VO_friendship/VO_diona/vo_diona_teammate_albedo_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fd/0y4euowas7ldu410rj4f6jeg57jq9vl.mp3"
    },
    {
      "title": "关于丽莎…",
      "desc": "丽莎姐姐，很和善对吧，很温柔对吧？但是，这样的姐姐也经常喝酒！呜呜呜…这是为什么啦…蒙德城已经没救了吧…",
      "voicefile": "VO_friendship/VO_diona/vo_diona_teammate_lisa_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c2/sfm90jdpzcqk5wa4aa6zh1yrk7qrkp4.mp3"
    },
    {
      "title": "关于香菱…",
      "desc": "我向香菱讨过一份「口感搭配特别糟糕的食物组合」，据说是她亲自实践下来的，绝对难吃什么的…没用，完全没用。「续杯」两个字已经听到猫耳朵都生茧了！呜…",
      "voicefile": "VO_friendship/VO_diona/vo_diona_teammate_xiangling_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/6c/esfc3obzlarnux9yqq2496q92wicc2o.mp3"
    },
    {
      "title": "关于可莉…",
      "desc": "可莉每次来找我玩的时候，我都只好把她带去离酒馆远一点的地方。酒和炸弹…实在是太危险了！就算我想摧毁蒙德酒业，也得用堂堂正正的方式。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_teammate_klee_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/2d/g2yqx8n2hjyukkaxa5dq41k2166j9wf.mp3"
    },
    {
      "title": "关于父亲…",
      "desc": "爸爸是我最尊敬的人！爸爸是最厉害的人！但是…喝了酒的爸爸，唔——果然还是要早点终结蒙德的酒业！没时间闲聊啦！",
      "voicefile": "VO_friendship/VO_diona/vo_diona_teammate_father_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/37/9dhv0z9ae60xxlv10en8qgf46qv9tk9.mp3"
    },
    {
      "title": "想要了解迪奥娜·其一",
      "desc": "「调酒师」可是很忙的！即使不在酒馆工作，也要抽出时间来收集配方。所以，所以没有要紧事情的话，就不要来打搅我。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_friendship_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/39/o124h8ntp84545hb53knfvxswuyusnb.mp3"
    },
    {
      "title": "想要了解迪奥娜·其二",
      "desc": "你不会…也像那些讨厌的酒鬼一样要我学猫咪叫吧？不会的，绝对不会的！我才不是什么抖抖耳朵伸伸懒腰的宠物！我可是…可是…「酒业杀手」！",
      "voicefile": "VO_friendship/VO_diona/vo_diona_friendship_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b8/1v7mzwlmfbehhnvghvn61zno52hixis.mp3"
    },
    {
      "title": "想要了解迪奥娜·其三",
      "desc": "你问我…为什么「酒业杀手」变成了「猫尾酒馆」的招牌…？你，你是故意这样问的吧！就是想看我的笑话。呜，坏人！再也不给你调喝的了，水也不给！",
      "voicefile": "VO_friendship/VO_diona/vo_diona_friendship_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/a5/p6qqhpn5n7zt5h5cah3ersqvs0p0hjz.mp3"
    },
    {
      "title": "想要了解迪奥娜·其四",
      "desc": "别再惹我了啊，我宽容大度，但也不好欺负！我警告你，我生起气来可是会咬人的！喵！虽然不一定舍得咬你…",
      "voicefile": "VO_friendship/VO_diona/vo_diona_friendship_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d8/imksqf3e9dhi3nf59e0fp72h9o6akz0.ogg"
    },
    {
      "title": "想要了解迪奥娜·其五",
      "desc": "我和你…已经成为好朋友了，对吧。我隐约记得…我以前也有过这样一个朋友，但我不确定那是不是梦…\n把你的手给我。啊呜，唔…暖和的。这样就好，不要变成梦走了…",
      "voicefile": "VO_friendship/VO_diona/vo_diona_friendship_05",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/ac/l2l42otjua1trrwts48ayqwjpit17ru.ogg"
    },
    {
      "title": "迪奥娜的爱好…",
      "desc": "我喜欢打猎，追捕猎物可是我的强项！但爸爸说野外情况瞬息万变，只有跟着可靠的大人一起，才能深入森林。你…算是可靠的大人吧？",
      "voicefile": "VO_friendship/VO_diona/vo_diona_pref_hobby",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/6c/mp96yha1nijmgeh2jxeshdpyegll7qx.mp3"
    },
    {
      "title": "迪奥娜的烦恼…",
      "desc": "嗯…到底怎样才能调出难喝的酒呢…连我给予厚望的噩梦搭配——「酱油牛奶绝云椒椒配蒲公英籽特调」都被说成是「小迪奥娜又有进步了」，呜…我不会认输的…",
      "voicefile": "VO_friendship/VO_diona/vo_diona_dialog_annoyed",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f4/6alrjc9d0d7dv65mximhj3ensnbo9dk.mp3"
    },
    {
      "title": "喜欢的食物…",
      "desc": "我喜欢吃鱼！作为主食的鱼…爸爸做的鱼！但是…不要作为下酒菜，那是对鱼的亵渎！",
      "voicefile": "VO_friendship/VO_diona/vo_diona_pref_foodLike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/78/qqupmh5k5smrzgsly8kl62e3c4v99h4.mp3"
    },
    {
      "title": "讨厌的食物…",
      "desc": "胡萝卜、土豆、洋葱、番茄…这些味道都不太喜欢。我，我可不是吃素的啊！",
      "voicefile": "VO_friendship/VO_diona/vo_diona_pref_foodDislike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4a/3b4kn1p4pguci8ys5p1lesbu1q9p41t.mp3"
    },
    {
      "title": "收到赠礼·其一",
      "desc": "好吃…我，我就随便问一下哦，下次还有吗？",
      "voicefile": "VO_friendship/VO_diona/vo_diona_spice_pref_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/0d/tmdt7tdd5c2f7d4o8oy2b6q9wpe70pg.mp3"
    },
    {
      "title": "收到赠礼·其二",
      "desc": "你可别指望我尝了点甜头，就会来蹭你…",
      "voicefile": "VO_friendship/VO_diona/vo_diona_spice_normal_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/62/jhwzue436dcbw27wulur1472prpah3y.mp3"
    },
    {
      "title": "收到赠礼·其三",
      "desc": "喂…你是把我当成路边的野猫了吗！",
      "voicefile": "VO_friendship/VO_diona/vo_diona_spice_dislike_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/68/slsjwxd9k4kqd9ppd64la3ahkyu5gnm.mp3"
    },
    {
      "title": "生日…",
      "desc": "炸鱼，配上这个我特别调制的酱料，给你。\n…没有加奇怪的东西！我认真调味的手艺才不会差呢，先尝过才可以说话。\n哼…这才对嘛…唔，那个，生日快乐。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_pref_birthday",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/1c/3q7vq2ktvj7hvnrpf8l6jbbzf2kxzul.mp3"
    },
    {
      "title": "突破的感受·起",
      "desc": "猫的眼睛，看得见黑暗中的一切猎物！",
      "voicefile": "VO_friendship/VO_diona/vo_diona_starUp_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/1c/3q7vq2ktvj7hvnrpf8l6jbbzf2kxzul.mp3"
    },
    {
      "title": "突破的感受·承",
      "desc": "猫的耳朵，听得见地上最细微的脚步声。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_starUp_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/2d/qn3gxlq9epyq1i2jeccmjof8j4jxscn.mp3"
    },
    {
      "title": "突破的感受·转",
      "desc": "猫的四肢，爬得上全提瓦特最高的树。",
      "voicefile": "VO_friendship/VO_diona/vo_diona_starUp_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/9b/3s1rq14q737v53zt5wnd1b4bvev84sj.ogg"
    },
    {
      "title": "突破的感受·合",
      "desc": "猫的鼻子，闻得出熟悉的、喜欢的人的…唔？！是你听错了！我怎么可能说出那种话…呜…",
      "voicefile": "VO_friendship/VO_diona/vo_diona_starUp_04",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/6/67/VO_ZH_Diona_Feelings_About_Ascension_-_04.ogg"
    }
  ],
