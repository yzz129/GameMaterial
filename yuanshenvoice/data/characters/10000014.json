  "voicePackageEn": "Barbara",
  "quoteCount": 70,
  "friendLines": [
    {
      "title": "初次见面…",
      "desc": "芭芭拉，闪耀登场~治疗就交给我吧，不会让你失望的！",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_draw_appear",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b5/hxj4a3e2aw2oundfm7ddctfs8nqzake.ogg"
    },
    {
      "title": "闲聊·犯困",
      "desc": "再这样站下去，会…想睡觉的…",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_explore_idle_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f3/0n953bd2v2co130lokabvq29mcimug8.ogg"
    },
    {
      "title": "闲聊·激励",
      "desc": "大家应该都在努力着，那我们也不能偷懒，对吧？",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_explore_idle_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/99/kz28sus7si6rw4sf2m86df8ev7mw0x7.ogg"
    },
    {
      "title": "闲聊·提神秘诀",
      "desc": "欸，是没精神了吗？尝一尝我做的辣味饮料吧，很提神的喔！",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_explore_idle_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/5b/db01ci6qvsrfvfjjm2fy7wv03i63v5h.ogg"
    },
    {
      "title": "下雨的时候…",
      "desc": "这样淋着不要紧吗？会感冒的吧？",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_weather_heavyRain_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/ea/kwgbtq8kbchsp1soy6avc8dahfigyx7.ogg"
    },
    {
      "title": "打雷的时候…",
      "desc": "呜哇！",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_weather_thunder_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/23/jmi5dsql6ntwc5gi9c6ce7033fuyplm.ogg"
    },
    {
      "title": "下雪的时候…",
      "desc": "欸！是雪花欸！冰冰凉凉的~！",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_weather_snowy_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/30/f8jmz49tfg25ekrqa60o1vqnfwybwoh.ogg"
    },
    {
      "title": "阳光很好…",
      "desc": "这样的好天气，嗯~适合比较明快的曲风呢！",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_weather_sunny_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c3/i7t22chf1l7y4oupvhgyxvg9attt78e.ogg"
    },
    {
      "title": "刮大风了…",
      "desc": "放心，我不会被吹走的！",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_weather_gale_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/6a/a0g3t33nnu2ag93b3d9ijkhffdl9es5.ogg"
    },
    {
      "title": "早上好…",
      "desc": "早安~今天也要加油呀。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_dialog_greetingMorning",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/ae/i7f38u7c7go7zp5p4qmostrdqxukck4.ogg"
    },
    {
      "title": "中午好…",
      "desc": "欸，想听我唱歌…？对不起，还…还没有到演出时间呢。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_dialog_greetingNoon",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/80/2cmy7tdw130hflo8thfmw1hm07j7a2s.ogg"
    },
    {
      "title": "晚上好…",
      "desc": "想吃猎鹿人餐馆的香辣鲈鱼…可是最近的肚子，呜…",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_dialog_greetingNight",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/5f/kop7029bplxw8b1on1zlwv0gr69d8y1.ogg"
    },
    {
      "title": "晚安…",
      "desc": "辛苦了！请好好休息吧。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_dialog_greetingNight2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/8f/i2ear8uig5weom983mdn8km37zqa4pq.ogg"
    },
    {
      "title": "关于芭芭拉自己…",
      "desc": "「指引我前进的风啊。在我困顿时给我继续前行的力量，在我迷惑时给我辨明善恶的智慧，在我遭受不义时给我抗争的勇气…」…哎呀，抱歉，刚才在专心祈祷。有什么事吗？",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_dialog_idle",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/ff/2smmfu2g4suvwi54e0aepx3s258tuac.ogg"
    },
    {
      "title": "关于我们·愿望",
      "desc": "我的愿望，是给身边的大家带来笑容！只要能帮上你的忙，我就很开心了。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_dialog_close1",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/8d/hd9qb81jhh5h3eecibyasco52xwzfgt.ogg"
    },
    {
      "title": "关于我们·梦想",
      "desc": "谢谢你陪我走到现在，离我的梦想已经越来越近了呢。未来的日子，也请多多关照啦~！",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_dialog_close2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/02/47cj3t4rnt2j2yvr2gytpp04mms577e.ogg"
    },
    {
      "title": "关于「神之眼」…",
      "desc": "每个人都会有自己的愿望。汇聚大家的愿望，让大家感到幸福，这一定，就是神给予我的使命吧。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_dialog_pendant",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/6a/94lm8nzkrnw727yitkris8pr0hdu587.ogg"
    },
    {
      "title": "有什么想要分享…",
      "desc": "蒙德城外青青的原野，真的百看不厌。但我听说，世界上还有蓝色的树林呢！就在海对岸的稻妻城那边。嗯！我还得多攒一点…欸？问我在攒什么？嘿嘿，是秘密哦~！",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_dialog_share",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c2/llkg3zw5cyrdpl2buiuvf5kaxmj2erz.ogg"
    },
    {
      "title": "感兴趣的见闻…",
      "desc": "向日葵一直对着阳光的样子，很耀眼呢。其实，妈妈送过我一条向日葵风格的礼裙…但我什么时候才能穿上它去演出呢？",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_pref_gift",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b3/3i4ah5pp15ttd8nyzlijyu4t9a0a47p.ogg"
    },
    {
      "title": "关于琴…",
      "desc": "代理团长大人…骑士团的领袖，大家都很喜欢她哦。欸？问我吗？我…我当然也非常尊敬她！",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_teammate_qin_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/86/5h0bg38f5g62ypgucx3ab6e68cdza4i.ogg"
    },
    {
      "title": "关于丽莎…",
      "desc": "我一直承蒙丽莎姐姐照顾呢。要是她也成为偶像的话，我绝对会全力应援，喊到嗓子哑掉…啊，这样会吓到别人的吧…",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_teammate_lisa_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/2f/8y2buxl4h321gs5f6isku209vjdcwoo.ogg"
    },
    {
      "title": "关于安柏…",
      "desc": "以前就经常看到安柏风风火火地往城外跑，侦察骑士还真是辛苦呀。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_teammate_ambor_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/43/selv5bc1uc0az4wn1cj8drn0fkkdu1y.ogg"
    },
    {
      "title": "关于迪卢克…",
      "desc": "迪卢克老爷吗？上次在「天使的馈赠」演出，他一直皱着眉头…是不是我唱的歌他不喜欢呢？",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_teammate_diluc_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/79/fqxmp7cw57b4pcrrhjw828hmzajeh9o.ogg"
    },
    {
      "title": "关于温迪…",
      "desc": "温迪的声音很好听！不过，他唱的歌跟我擅长的风格差异很大。我试着偷偷学过…那旋律还真是复杂呀。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_teammate_venti_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/a3/3m0xfemi56pxd9dunhztq4b3d05r692.ogg"
    },
    {
      "title": "关于班尼特…",
      "desc": "班尼特经常带着一身伤痕来教堂…他却一直毫不在意、大大咧咧地笑着。唔…还是应该更爱惜自己才好啊。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_teammate_bennett_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/52/2x0dy700vzxh7wympupv2qq2opte2uq.ogg"
    },
    {
      "title": "关于法尔伽…",
      "desc": "父亲跟着法尔伽大团长一起出远门了，也不知道路途中会不会遇到什么…啊，没关系，大团长可是「北风骑士」，一定没问题的！我…也会为他们祈祷的。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_teammate_varka_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/07/1mu9rwmrau02oyhqhgk9z0teieirgct.ogg"
    },
    {
      "title": "关于罗莎莉亚…",
      "desc": "罗莎莉亚修女虽然难以接近，也从不参加祈祷，但我觉得…唔，她一定是相信着风神的！不过，不过我并没有勇气和她交流就是了…",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_teammate_rosaria_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/1e/ofvgrv4zrz6ufz49z7hpngge53egpz1.ogg"
    },
    {
      "title": "关于诺艾尔…",
      "desc": "诺艾尔实在是太可爱了！人又温柔，还很有耐心，跟她在一起的时候，完全不会有什么压力…哦，对了，她做的茶点也很特别。又香，又甜，而且很健康，嘿嘿。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_teammate_noel_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/bd/dr81cbf23xqhxp8ck9zqjmqraydtm4m.ogg"
    },
    {
      "title": "想要了解芭芭拉·其一",
      "desc": "骑士们挥剑作战的样子好帅啊！你是不是也有这种感觉？我自己也试过用剑…欸嘿嘿，可惜我在剑术上，完全没有天赋呢。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_friendship_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/3e/4oyuek0qxjj6gqheo9upxajinw1r5x6.ogg"
    },
    {
      "title": "想要了解芭芭拉·其二",
      "desc": "想要治愈大家。就是这么简单的心情，让我成为了牧师。要是能帮上大家就好了。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_friendship_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/45/don6yand3gu0ndipkw4img57abxiu8v.ogg"
    },
    {
      "title": "想要了解芭芭拉·其三",
      "desc": "偶像，唔...是从艾莉丝那边了解到的…「优秀的偶像能够治愈人们的心灵。」嗯，嗯，总之就是这样啦。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_friendship_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/ea/leuqrl4ukf23qqvpgqx0817xwbjndhc.ogg"
    },
    {
      "title": "想要了解芭芭拉·其四",
      "desc": "我每天都在努力，这份努力…如果能配得上蒙德城大家的信任…",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_friendship_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/52/7h9co4qjeecbvf9vs4mntmt96qoa2wn.ogg"
    },
    {
      "title": "想要了解芭芭拉·其五",
      "desc": "每次演出的时候我都会想…我真的能够治愈蒙德城里的每个人么？但是看着你，我总觉得只要一步步向前，总有一天…欸？至少已经把你治愈了…？这时候不是应该说！我已经治愈很多人了吗？！不过这样也不错…",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_friendship_05",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/11/8e0vs0aezrrzx51ey73udj7i1e7rpvn.ogg"
    },
    {
      "title": "芭芭拉的爱好…",
      "desc": "是大家脸上的笑容，一直在支持我。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_pref_hobby",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d1/6o446jew2hqousk0lmmoim6ad95qqf0.ogg"
    },
    {
      "title": "芭芭拉的烦恼…",
      "desc": "同伴们一直在受伤…我，没有替大家分担痛苦的力量。但我可以尽最大的努力治疗！一定，要让大家恢复健康。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_dialog_annoyed",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/c8/kzlll22qn482z0a69omonan3xm50mvp.ogg"
    },
    {
      "title": "喜欢的食物…",
      "desc": "你喜欢麻辣小鱼干吗？我这还有两条…喏，给你一条！",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_pref_foodLike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4d/doewfbnnfchgubg0gvu81yfuyjna4hs.ogg"
    },
    {
      "title": "讨厌的食物…",
      "desc": "我不太喜欢苦的东西，特别是…苦瓜。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_pref_foodDislike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/42/krdyjfclklti0io8iu1z4s46r8q1kg1.ogg"
    },
    {
      "title": "收到赠礼·其一",
      "desc": "很少吃到那么合我口味的菜肴。今天是幸运日呢！",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_spice_pref_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d7/6wowxqvw0miuceujoq96vafar2zu0gx.ogg"
    },
    {
      "title": "收到赠礼·其二",
      "desc": "谢谢你特意做的这些，这次，是被你治愈了。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_spice_normal_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/8/86/VO_ZH_Barbara_Receiving_a_Gift_-_02.ogg"
    },
    {
      "title": "收到赠礼·其三",
      "desc": "不，不好…",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_spice_dislike_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/e/ef/VO_ZH_Barbara_Receiving_a_Gift_-_03.ogg"
    },
    {
      "title": "生日…",
      "desc": "请收下！这个是给你的生日礼物，专属签名绘哟~欸嘿，等下一首新歌，我会第一时间唱给你听的！生日快乐呀！",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_pref_birthday",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d7/6wowxqvw0miuceujoq96vafar2zu0gx.ogg"
    },
    {
      "title": "突破的感受·起",
      "desc": "芭芭拉的舞步…治愈力UP！",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_starUp_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/37/kqd45qwilbo8lc4qb7z8pprhsqf8bcc.ogg"
    },
    {
      "title": "突破的感受·承",
      "desc": "谢谢你的支持~啊，不好，好像有点太激动了…心脏怦怦跳个不停。",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_starUp_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/dd/ef7e2mu4a35clfu52lt7c19r2rh325m.ogg"
    },
    {
      "title": "突破的感受·转",
      "desc": "请告诉我继续变强的秘诀~欸？放心交给你就行？…这怎么行，我也要一起努力！",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_starUp_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/27/bztwjawg9lhf7hddsrzynhjtzyvtlr7.ogg"
    },
    {
      "title": "突破的感受·合",
      "desc": "和你一起旅行，我才意识到舞台是没有边界的。谢谢你！嘿嘿…好！一起喊出那句咒语吧！三、二、一，——芭芭拉冲呀！",
      "voicefile": "VO_friendship/VO_barbara/vo_barbara_starUp_04",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/4/42/VO_ZH_Barbara_Feelings_About_Ascension_-_04.ogg"
    }
  ],
