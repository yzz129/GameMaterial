  "voicePackageEn": "Freminet",
  "quoteCount": 72,
  "friendLines": [
    {
      "title": "初次见面…",
      "desc": "你好，我叫菲米尼，是一名潜水员…啊，握手的话就不必了…我是说，不用那么客气。咳、如果你需要勘测水下遗迹或者打捞素材的话，我能为你所用…但其他方面的指派，我可能会让你失望…",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_draw_appear_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/6/69/VO_ZH_Freminet_Hello.ogg"
    },
    {
      "title": "闲聊·海底",
      "desc": "想去无人的海底，一个人安静地待着…",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_character_idle_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/d/dc/VO_ZH_Freminet_Chat_-_Ocean_Depths.ogg"
    },
    {
      "title": "闲聊·原理",
      "desc": "熟悉机械装置的构造与原理，就能够排查故障…但要熟悉一个人却难得多。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_character_idle_02",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/2/21/VO_ZH_Freminet_Chat_-_Principles.ogg"
    },
    {
      "title": "闲聊·家",
      "desc": "无论我在何处漂流，只要那盏炉火亮着，我就有家可归…",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_character_idle_03",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/4/42/VO_ZH_Freminet_Chat_-_Home.ogg"
    },
    {
      "title": "下雨的时候…",
      "desc": "每到雨天，心情都会沉重不少…",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_weather_heavyRain_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/7/70/VO_ZH_Freminet_When_It_Rains.ogg"
    },
    {
      "title": "雨过天晴…",
      "desc": "雨停了吗？那就好。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_weather_afterRain_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/9/90/VO_ZH_Freminet_After_the_Rain.ogg"
    },
    {
      "title": "打雷的时候…",
      "desc": "佩伊，我会保护你的。不要怕。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_weather_thunder_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/5/5c/VO_ZH_Freminet_When_Thunder_Strikes.ogg"
    },
    {
      "title": "下雪的时候…",
      "desc": "我是不是应该把潜水头盔戴上…保暖…",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_weather_snowy_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/7/77/VO_ZH_Freminet_When_It_Snows.ogg"
    },
    {
      "title": "刮大风了…",
      "desc": "想钻进海里。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_weather_gale_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/3/3c/VO_ZH_Freminet_When_the_Wind_Is_Blowing.ogg"
    },
    {
      "title": "早上好…",
      "desc": "早。请问，有需要我执行的任务吗？没有的话，我准备出门了。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_dialog_greetingMorning",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/d/d7/VO_ZH_Freminet_Good_Morning.ogg"
    },
    {
      "title": "中午好…",
      "desc": "机械内部没有故障，是发条老化了吗？那修起来简单…抱歉，我…呃…你刚才和我说了什么吗？",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_dialog_greetingNoon",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/2/24/VO_ZH_Freminet_Good_Afternoon.ogg"
    },
    {
      "title": "晚上好…",
      "desc": "要来一碗海鲜汤吗？是用今天现捕的虾和贝类做的。我不怎么会做饭，但食材新鲜，味道…应该不会太差。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_dialog_greetingNight",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/a/ac/VO_ZH_Freminet_Good_Evening.ogg"
    },
    {
      "title": "晚安…",
      "desc": "你休息吧。我还想看一会儿书再睡。欸？什么书？这个…唔，是有关潜、潜水的书，有很多技术要点要学…总之，先道晚安了！",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_dialog_greetingNight2",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/e/ec/VO_ZH_Freminet_Good_Night.ogg"
    },
    {
      "title": "关于菲米尼自己·潜水",
      "desc": "如你所知，我为数不多的强项是潜水，我和汐藻打交道的时间比和人说话的时间还多。它们不会责问，不会流露失望，只安静地陪你一同漂流…水下的世界要比陆上简单许多。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_dialog_idle",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/8/89/VO_ZH_Freminet_About_Freminet_-_Diving.ogg"
    },
    {
      "title": "关于菲米尼自己·发条企鹅",
      "desc": "在我感到孤独的夜晚，是佩伊给了我最珍贵的陪伴。我想，或许有其他孩子像我一样，需要一位陪在身边的玩具伙伴。于是，我做了一批发条企鹅，拿去莱舒的发条工坊寄售…听说口碑不错，但销量一般，来购买的反倒是成年人居多…唉。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_dialog_idle2",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/f/f1/VO_ZH_Freminet_About_Freminet_-_Clockwork_Penguin.ogg"
    },
    {
      "title": "关于我们·命令",
      "desc": "「命令」就像是背在我身后的发条，离开它反而令我不习惯。如果有任何对我的安排，请你一定不要顾虑。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_dialog_close",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/f/f4/VO_ZH_Freminet_About_Us_-_Orders.ogg"
    },
    {
      "title": "关于我们·同伴",
      "desc": "让我多了解一点你的事吧。你的爱好、口味，喜欢的颜色，想养的动物…既然你是我的「同伴」，那我们之间的联结，就比齿轮与机关更紧密了。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_dialog_close1",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/1/10/VO_ZH_Freminet_About_Us_-_Companionship.ogg"
    },
    {
      "title": "关于「神之眼」…",
      "desc": "自从有了「神之眼」，我潜水已经不再需要使用头盔。但我却离不开它。它将我与外界的嘈杂隔绝，让我感到安全。「神之眼」、头盔…还有佩伊，我的呼吸，一直在借助它们的力量。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_dialog_pendant",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/5/56/VO_ZH_Freminet_About_the_Vision.ogg"
    },
    {
      "title": "有什么想要分享…",
      "desc": "透过海水望天，阳光也不会那么刺眼。所以，我才总是愿意待在水里。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_dialog_share_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/5/5d/VO_ZH_Freminet_Something_to_Share.ogg"
    },
    {
      "title": "感兴趣的见闻·苍晶螺",
      "desc": "我曾在水下见到过许多苍晶螺，盯着那些精致细巧的纹路，不知不觉就忘记了时间。这么美丽的生物已经变成了化石，那我们周围的景色，是不是早晚也会沉入深海之下呢？",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_pref_gift_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/9/97/VO_ZH_Freminet_Interesting_Things_-_Beryl_Conches.ogg"
    },
    {
      "title": "感兴趣的见闻·幽光星星",
      "desc": "幽光星星总是会依附在其他东西之上，有时是礁石，有时是码头，更多时候则是庞大的水下建筑群。你说，它们是不是就像飞萤靠近光源那样，对人类心存向往呢？",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_pref_gift_02",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/f/f7/VO_ZH_Freminet_Interesting_Things_-_Lumitoile.ogg"
    },
    {
      "title": "关于「父亲」·眼泪",
      "desc": "「父亲」不喜欢孩子们哭，说眼泪是感性和软弱的混合物。被「父亲」训斥过后，我总要忍到水下才敢哭出来。还好海露花会陪着我。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_teammate_arlecchino_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/6/64/VO_ZH_Freminet_About_Father_-_Tears.ogg"
    },
    {
      "title": "关于「父亲」·教导",
      "desc": "小时候，我受到的教育是：为了家，我们应该献出自己的生命。自从「父亲」掌权后，这一理念产生了变化。「父亲」说我们每一个人都很重要，必须得重视自己的生命，发挥所有力量，在这个世界上站稳脚跟…说实话，这比单纯服从命令难多了。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_teammate_arlecchino_02",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/1/1c/VO_ZH_Freminet_About_Father_-_Teaching.ogg"
    },
    {
      "title": "关于林尼·表演",
      "desc": "在家里，林尼时常会向我表演一些小魔术。一旦我笑了的话，他就会特别开心，说那个魔术肯定会让观众都满意…我平时真的笑那么少吗？",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_teammate_lyney_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/2/2a/VO_ZH_Freminet_About_Lyney_-_Magic_Shows.ogg"
    },
    {
      "title": "关于林尼·面具",
      "desc": "林尼是我们小队中的领袖，总是以哥哥的身份自居…我能看出他硬撑的时候，也尝试过劝他不要一直戴着面具…但他不肯承认，我们还起过争执…从那之后，我就不再触碰这个话题了。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_teammate_lyney_02",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/a/aa/VO_ZH_Freminet_About_Lyney_-_Mask.ogg"
    },
    {
      "title": "关于琳妮特…",
      "desc": "同样的任务，如果交给林尼或者琳妮特，他们就能完成得很出色，而我却办不好。琳妮特总宽慰我说大家各有所长，家里那些突然出故障的器械都在靠我维修…哈，我在其他方面也能这么得心应手就好了。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_teammate_lynette_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/b/b4/VO_ZH_Freminet_About_Lynette.ogg"
    },
    {
      "title": "关于那维莱特…",
      "desc": "有次我浮出海面时，正巧见到最高审判官大人独自站在海边。他或许在想心事，或许在看风景…我当然没问。我只和他匆匆对了一眼就潜回海里了。事后想想像是做了亏心事一样…唉。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_teammate_neuvillette_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/6/62/VO_ZH_Freminet_About_Neuvillette.ogg"
    },
    {
      "title": "关于芙宁娜·回避",
      "desc": "我…我没法客观地评价水神大人，还是…不说了吧。况且我和她接触得也不多…看法肯定会有偏颇。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_teammate_furina_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/c/ca/VO_ZH_Freminet_About_Furina_-_Avoiding_the_Question.ogg"
    },
    {
      "title": "关于芙宁娜·判断",
      "desc": "好吧，我见过水神大人坐在观众席上的样子。在我看来，她说话的时候非常引人瞩目，沉默的时候反倒更耐人寻味…她的眼睛，就像不透光的海底那样，藏着深深的秘密，害怕他人的碰触…我、我乱说的…对不起。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_teammate_furina_02",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/5/50/VO_ZH_Freminet_About_Furina_-_Verdict.ogg"
    },
    {
      "title": "关于娜维娅…",
      "desc": "我听林尼聊了事情经过，很感谢你和娜维娅小姐的慷慨与热心，也请代我向她转达…欸？当面道谢？我、我有点…唔，肚子突然疼起来了，抱歉先走一步。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_teammate_navia_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/4/4a/VO_ZH_Freminet_About_Navia.ogg"
    },
    {
      "title": "关于夏洛蒂…",
      "desc": "不知道为什么，夏洛蒂小姐始终不愿相信我是一名普通的潜水员，反倒觉得我的身世藏有值得报道的「新闻」…是我说谎的时候不够自然吗？",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_teammate_charlotte_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/b/bd/VO_ZH_Freminet_About_Charlotte.ogg"
    },
    {
      "title": "关于克洛琳德…",
      "desc": "克洛琳德小姐对我有救命之恩，却说不需要我做任何「报答」。给别人添了麻烦，到头来只能空洞地道谢…这种感觉，真不好受啊。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_teammate_clorinde_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/c/c9/VO_ZH_Freminet_About_Clorinde.ogg"
    },
    {
      "title": "关于夏沃蕾…",
      "desc": "听说夏沃蕾小姐常去博蒙特工坊，为火枪购置最昂贵精细的零件。我要是能挣到很多钱的话，说不定也能给佩伊换上性能更好的零件了吧。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_teammate_chevreuse_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/6/6b/VO_ZH_Freminet_About_Chevreuse.ogg"
    },
    {
      "title": "想要了解菲米尼·其一",
      "desc": "请原谅。我讲不出什么有趣的故事…说了也会扫你兴致…",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_friendship_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/1/12/VO_ZH_Freminet_More_About_Freminet_-_01.ogg"
    },
    {
      "title": "想要了解菲米尼·其二",
      "desc": "要是你答应不看着我，或者允许我戴上头盔的话…我可以试着说下去。心理素质是一方面…但更主要的原因，恐怕是我习惯了逃避自己的过去…",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_friendship_02",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/3/39/VO_ZH_Freminet_More_About_Freminet_-_02.ogg"
    },
    {
      "title": "想要了解菲米尼·其三",
      "desc": "书上说，人死后会化作天上的星辰，遥望人世…我讨厌自己的亲生父亲，他抛下了我和母亲，我不在乎他…但如果母亲在天上看见她用生命保护下来的孩子如此怯弱，躲在另一个屋檐下那么久，也没有成长为独当一面的样子，她会不会…对我感到失望呢？",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_friendship_03",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/b/bc/VO_ZH_Freminet_More_About_Freminet_-_03.ogg"
    },
    {
      "title": "想要了解菲米尼·其四",
      "desc": "我不太想回忆前任院长管理时期的「家」。只能说…躲进海里的习惯，就是那时候养成的…但「父亲」不仅改变了我，也改变了我对「家」的看法…后来林尼和琳妮特也成为了我们的「家人」…那是我第一次遇到能交心的伙伴。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_friendship_04",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/a/a3/VO_ZH_Freminet_More_About_Freminet_-_04.ogg"
    },
    {
      "title": "想要了解菲米尼·其五",
      "desc": "我曾发誓，我会不惜一切地守护现在这个家，一丝一毫都不退让。它不再是前任院长的命令，或者「父亲」的期待…而是我自己的愿望。请你保守「家」的秘密…还有我的愿望。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_friendship_05",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/a/aa/VO_ZH_Freminet_More_About_Freminet_-_05.ogg"
    },
    {
      "title": "菲米尼的爱好…",
      "desc": "除了潜水之外，我还喜欢拆解和改造机械，有时也会把收集来的材料制作成新的发条玩具。佩伊？它更像是我的家人，和我一起长大…是真的。我一直在为它增添更多功能…真希望未来有一天，它能够自由地飞上高空。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_pref_hobby",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/7/7e/VO_ZH_Freminet_Hobbies.ogg"
    },
    {
      "title": "菲米尼的烦恼…",
      "desc": "…真难回答啊。既可以说我没有亟待解决的问题，又可以说我身上麻烦重重。即使将我自己看作一台橱窗里的发条玩偶，我也想不出要从哪里开始维修…症结可能还是会落回…我太弱小了吧。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_dialog_annoyed_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/6/64/VO_ZH_Freminet_Troubles.ogg"
    },
    {
      "title": "喜欢的食物…",
      "desc": "鱼、虾之类的海鲜…螃蟹也可以。我很高兴自己和林尼、琳妮特他们口味相近，大家能吃到一起去…在烹饪形式的选择上，我会尊重他们的意见。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_pref_foodLike",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/6/69/VO_ZH_Freminet_Favorite_Food.ogg"
    },
    {
      "title": "讨厌的食物…",
      "desc": "我不太能喝咖啡。一旦超过半杯，没过多久，心脏就会跳得很快，呼吸也没法恢复平稳。人们常说咖啡有提神的效用，但对我来说，它更像是一种折磨…",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_pref_foodDislike",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/d/db/VO_ZH_Freminet_Least_Favorite_Food.ogg"
    },
    {
      "title": "收到赠礼·其一",
      "desc": "好吃。好吃到让人舍不得吃完。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_spice_pref_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/c/ca/VO_ZH_Freminet_Receiving_a_Gift_-_01.ogg"
    },
    {
      "title": "收到赠礼·其二",
      "desc": "烹饪是你的爱好吗？所以你才会不断投入心血，做出这些美味的菜肴。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_spice_normal_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/1/11/VO_ZH_Freminet_Receiving_a_Gift_-_02.ogg"
    },
    {
      "title": "收到赠礼·其三",
      "desc": "对不起，刚才我有一瞬间想要逃走。明明是你辛苦做出来的东西…",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_spice_dislike_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/4/48/VO_ZH_Freminet_Receiving_a_Gift_-_03.ogg"
    },
    {
      "title": "生日…",
      "desc": "你愿意跟我去个地方吗？我知道一片水域，景色特别漂亮，甚至比书里描绘的世界更加梦幻。我在那里有个秘密基地，还养了一些会发光的海洋生物…我想陪你度过一个不一样的生日，最后再说出那句祝福…能给我这个机会吗？",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_pref_birthday_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/4/42/VO_ZH_Freminet_Birthday.ogg"
    },
    {
      "title": "突破的感受·起",
      "desc": "真的…可以吗？",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_starUp_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/6/6f/VO_ZH_Freminet_Feelings_About_Ascension_-_01.ogg"
    },
    {
      "title": "突破的感受·承",
      "desc": "即使不为我做这些，我也会服从你的。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_starUp_02",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/b/bd/VO_ZH_Freminet_Feelings_About_Ascension_-_02.ogg"
    },
    {
      "title": "突破的感受·转",
      "desc": "你的时间和精力非常宝贵，拿去陪别人会更好…吧。",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_starUp_03",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/0/01/VO_ZH_Freminet_Feelings_About_Ascension_-_03.ogg"
    },
    {
      "title": "突破的感受·合",
      "desc": "我不知道如何才能报答你，要怎样表达才足够传递自己的想法…我…我平时练习太少，现在非常害怕会说错话…让你不开心，让你觉得后悔…对不起，我可以什么都不说，就在你身边待一会儿吗？",
      "voicefile": "VO_friendship/VO_freminet/vo_freminet_starUp_04",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/7/7d/VO_ZH_Freminet_Feelings_About_Ascension_-_04.ogg"
    }
  ],
