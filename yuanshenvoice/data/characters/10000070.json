  "hasLocalPack": false,
  "voicePackageUrl": "https://huggingface.co/datasets/simon3000/genshin-voice/resolve/main/speaker-archives/Chinese/501-plus/Nilou.zip",
  "voicePackageEn": "Nilou",
  "quoteCount": 67,
  "friendLines": [
    {
      "title": "初次见面…",
      "desc": "你好，我是来自祖拜尔剧场的妮露。今天上演的剧目是这一支舞。请你不要眨眼哦，要开始了——",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_draw_appear_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b1/4yjjz08ob8rrhdo0muxeo5qhghhpl6i.mp3"
    },
    {
      "title": "闲聊·练习",
      "desc": "先这样…下一个动作是…这样吧，嗯…嗯！",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_character_idle_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/22/jiwrzj6axn21dx8oius5kdlq0i6i6oq.mp3"
    },
    {
      "title": "闲聊·困意",
      "desc": "深呼吸，吹一个大大的气球，把困意放进气球里，呼——气球飞走吧。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_character_idle_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/61/on3156vxlb5jci2fhl1b3yo1b8vfy88.mp3"
    },
    {
      "title": "闲聊·休息",
      "desc": "这样清闲的日子倒也不错嘛，优哉游哉。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_character_idle_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/90/j77tawt15i7t51u6ccvsumy65uiqzj2.mp3"
    },
    {
      "title": "下雨的时候…",
      "desc": "天气和心情一样，有时候会变得阴沉沉的，但是不用着急，雨后的天空会更加澄澈。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_weather_heavyRain_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4d/0zuioqdvm5mvxt7pjwxlc1zeyl2eup0.mp3"
    },
    {
      "title": "打雷的时候…",
      "desc": "雷声有点恐怖呢，你会害怕吗？我可以分享你一个神奇的方法哦。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_weather_thunder_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/8e/1hlegl53lqvydnj7lh9qa1o8fbkr7ch.mp3"
    },
    {
      "title": "下雪的时候…",
      "desc": "欸？哇——下雪了。你听，下雪的簌簌声，加上旋转着的雪花，像不像自然的精灵在跳舞？",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_weather_snowy_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/a9/n4mokr2b2fno5y1ctpswwudbccb6n1q.mp3"
    },
    {
      "title": "阳光很好…",
      "desc": "阳光明媚的日子…晒得暖洋洋的。唔，会犯困…",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_weather_sunny_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/81/ebja7ktxb56el2fru8xuk6aebwqiakq.mp3"
    },
    {
      "title": "刮大风了…",
      "desc": "你还好吗？小心风沙哦。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_weather_gale_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/a4/2zw881m6mqi9ey31o761qc9wswiat79.mp3"
    },
    {
      "title": "早上好…",
      "desc": "早上好哦。欸？你盯着我看是…哦头、头发翘起来了吗？啊，先别看我，唔，我马上整理好。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_dialog_greetingMorning",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/ad/mc5rz7tdmrjtsbuo7by75ab0n1n1kls.mp3"
    },
    {
      "title": "中午好…",
      "desc": "唔…嗯…中午吃饼好呢，还是吃饭呢…要不吃豆泥吧？",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_dialog_greetingNoon",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4e/5s7n3m1k83bdby3l5llm9t8uu01blr9.mp3"
    },
    {
      "title": "晚上好…",
      "desc": "晚上好，今晚我在祖拜尔剧场有演出。给你两张剧票吧？",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_dialog_greetingNight",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/2d/pef5njeih0e8g29nz5cuuvfzcomldmw.mp3"
    },
    {
      "title": "晚安…",
      "desc": "睡前把烦恼全部都倾诉掉，会睡得比较香哦。如果你愿意，我很乐意当你的听众。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_dialog_greetingNight2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/a3/87pd7ie3w96yrfopmxugw23qkpjveo4.mp3"
    },
    {
      "title": "关于妮露自己·肢体语言",
      "desc": "有时候，舞蹈比语言更能传达出心情，不知道该说什么好的时候，就跳舞吧。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_dialog_idle",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d7/bnlr53xu9fkxh7a62k78ks6v5qvapjb.mp3"
    },
    {
      "title": "关于妮露自己·舞蹈与知识",
      "desc": "探究知识需要很高很高的天赋，很多人拼了命地努力，结果劳累又沮丧…但跳舞就不一样了，就算看不懂门道，也能看个热闹。要是能从这份肢体动作中品味到艺术的美丽与价值，那我就更开心了。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_dialog_idle2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e6/9pcasleed19fc7h2vbq894ssvrp7egp.mp3"
    },
    {
      "title": "关于我们·缓解生气",
      "desc": "你会生闷气吗？嗯，生闷气是不好的。来，跟着我做。先在身前用右手画一个大大的圆，然后，双手把讨厌的事都从胸口里取出来，放在圆里。接着，用力地推出去！怎么样，心情好起来了吗？",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_dialog_close",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/bf/45w6z3zgkl4sljudpkmqu8w90ve0fhn.mp3"
    },
    {
      "title": "关于我们·外出冒险",
      "desc": "尽管我之前没离开过须弥城，但…我想和你一起去冒险。哦，到陌生的地方，我适应一下就好…唔，稻妻的沙滩下，真的不会有很大很大的沙虫，突然钻出来吗？",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_dialog_close1",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/62/n80j61vg40q49a62sewyxggjvmmic7z.mp3"
    },
    {
      "title": "关于「神之眼」…",
      "desc": "我的神之眼是第一次登台跳舞时拿到的。我想，神明大人会成为我的观众，一定也认可了人类艺术的美丽之处吧。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_dialog_pendant",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/3e/c1pwa6humaog3bd6l1uig5ivn858u7i.mp3"
    },
    {
      "title": "有什么想要分享…",
      "desc": "努力没有结果，也是很正常的。就像我不管怎么努力，也没办法理解明论派的知识。嗯，这个时候晃一晃脑袋，让大脑转个弯，换个方向就好了。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_dialog_share_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b0/2piykvhj4sn93mhoc2kubuofxqrsd1q.mp3"
    },
    {
      "title": "感兴趣的见闻·晶蝶之舞",
      "desc": "晶蝶有各种各样的颜色，很漂亮。当你实在按捺不住好奇心，悄悄伸出手的时候，它们就会一下子跳起优美而迅疾的舞步，离你远去。啊，我要是会飞的话，就能学会晶蝶之舞了。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_pref_gift_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/94/fwjcn9ex0da37r6f2vhwpio7yta2431.mp3"
    },
    {
      "title": "感兴趣的见闻·帕蒂沙兰",
      "desc": "花神大人跳舞的时候，真正的帕蒂沙兰会在她踏足过的地上盛开。…啊，听起来就非常美好，真想见一见这样的场景。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_pref_gift_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/94/nehsch7rd3xdk4vwr3gei2vv84bjwnk.mp3"
    },
    {
      "title": "关于赛诺…",
      "desc": "教令院的人，我不太敢接触，毕竟他们对歌舞艺术的印象都不好。我常常会想，那他们会通过什么来解闷呢？呃…你说赛诺的话，会玩「七圣召唤」？真是不可思议呢。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_teammate_cyno_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/66/jr37zw1hoexvwpg3ayf8hf7e7ndnyuq.mp3"
    },
    {
      "title": "关于提纳里…",
      "desc": "据说他是很厉害的植物学家。那他分辨蘑菇的本领肯定很厉害，至少不会吃到毒蘑菇…好羡慕呀。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_teammate_tighnari_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d6/1ysa7gouk489piyhp2lr31o4lsguqrn.mp3"
    },
    {
      "title": "关于柯莱…",
      "desc": "她偶尔会来看我的演出，是一位很热心的见习巡林员呢。她还提醒过我小心迷路，这是为什么呢？我也没有迷路过呀。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_teammate_collei_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/af/t3jnwln5hhwlxqejbfjw4q9vii84s29.mp3"
    },
    {
      "title": "关于卡维…",
      "desc": "我听说是他建造了华美的艾尔卡萨扎莱宫，能建造出那样的作品，过程应该快乐又陶醉吧。就像我练舞的时候一样，只要一想到能跳给大家看，就充满了喜悦和动力呢。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_teammate_kaveh_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f8/28m2ijw9n4b8n16o3rj9t5afxs2imcy.mp3"
    },
    {
      "title": "关于迪希雅…",
      "desc": "最近发生了那么多事情，总觉得很不可思议。我原本想为迪希雅和迪娜泽黛挑选一些合适的礼物。但我自己拿不定主意，嗯…要是把大巴扎朋友们推荐的品种全送去，又太多了。哎呀，到底该怎么办才好呢？",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_teammate_dehya_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/a0/dccxdndvrp71fpolh3e19zkcpa8rxhi.mp3"
    },
    {
      "title": "关于多莉…",
      "desc": "出手阔绰的多莉大商人也曾看过我跳舞。我记得，有一次她和祖拜尔先生商量了什么事情，之后就再也没来过了。会是什么事情呢？嗯…呃？你是说她可能想带我进行一场提瓦特巡演？不会吧，祖拜尔先生肯定帮忙拒绝了吧…应该拒绝了吧…",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_teammate_dori_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4f/7vbhs02k1hzxqpq344n9hkvaozs3kta.mp3"
    },
    {
      "title": "关于小吉祥草王…",
      "desc": "大巴扎的大家都很喜欢小吉祥草王大人，好想听听她对我跳的花神之舞的评价呀…啊！不、不，还是算了算了。她真的来了，我肯定会紧张得不得了。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_teammate_nahida_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/53/k40w3jr2x91815ndt8es4tu8tp24lub.mp3"
    },
    {
      "title": "想要了解妮露·其一",
      "desc": "唔——啊！抱歉，我在想等下去吃什么好呢？有点出神了…你需要帮忙吗？",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_friendship_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/a7/rr1n2lv9cyg7n4qqf9zvrs7i5g15ezx.mp3"
    },
    {
      "title": "想要了解妮露·其二",
      "desc": "我的老师教过我很多跳舞的要领，但她说，最重要的还是要把情感都投入到舞蹈里，因为这样才是最能打动人的。有所感，才能抒发。想要传达美丽的话，我就要成为美丽本身吧。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_friendship_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/30/qxcgv5x23c2jkp730uoudthp7cscakh.mp3"
    },
    {
      "title": "想要了解妮露·其三",
      "desc": "有时候我会收到观众们的来信，说他们因为我的舞蹈打起了精神。我会和祖拜尔剧场的大家共同分享这份快乐。虽然在观众眼里，我是在台前的那一个，但在我心中，这永远是靠所有人的努力才能取得的成果。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_friendship_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/80/s8igcjot6ycei3tzd0ioyb7lhl8v71g.mp3"
    },
    {
      "title": "想要了解妮露·其四",
      "desc": "大巴扎有时候会有一些杂技表演，比如说不停抛起球来又不停接住。以前我也试过这个，但是不知道怎么回事就是接不住球，反而全掉头上了。当时祖拜尔先生他们都笑了起来。嗯…好像在他们眼里，我的身体协调能力应该特别强一样…暴露短处了呢。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_friendship_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/bd/ezw07fzq27zce96fly5iuoki4huoyff.mp3"
    },
    {
      "title": "想要了解妮露·其五",
      "desc": "以前有人说我就像是暖阳下的绿洲，让人感到治愈与温暖。我多多少少会高兴一下，但我的追求、我试图向大家呈现的价值不止在此。不过，和你相处久了我才知道，被人照顾和关怀是这样的感觉。现在…现在，我感觉那个比喻更适合你。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_friendship_05",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/35/0lpgqemxksofino8gq3zabcob6flkw9.mp3"
    },
    {
      "title": "妮露的爱好…",
      "desc": "我的人生就是跳舞，跳舞就是我的人生…到底该说哪个才比较好呢？哎呀，我果然不适合思考这些太有逻辑的东西。总之，我会一直跳下去的。用我的表演，让这份艺术之美被更多人看见。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_pref_hobby",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/9f/0vqifjr8pr5utexwgokw7r360xl5wce.mp3"
    },
    {
      "title": "妮露的烦恼…",
      "desc": "我还是搞不懂哪些蘑菇有毒，哪些又没有…据说，颜色不管是鲜艳还是朴素的蘑菇，都有可能有毒。唔，好像明白了什么，又好像什么都没明白…",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_dialog_annoyed",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/a4/31l3wrxhf46mvyejczspdbb1yybj1ho.mp3"
    },
    {
      "title": "喜欢的食物…",
      "desc": "甜食总能让人心情愉快，须弥大多数人都喜欢甜食哦！欸，你要不要也试试看？我可以给你一一介绍。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_pref_foodLike_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b8/m0tdaqrqwgvfj2ed62xdc03bkow7qjq.mp3"
    },
    {
      "title": "讨厌的食物…",
      "desc": "我有点难以接受菌菇那一类，主要是害怕。不是那种见到了想逃走的害怕啦。我…我是小时候误吃过毒蘑菇，在床上躺了好几天…如果你想尝一尝须弥的菌菇美食，要记得确保是无毒蘑菇哦。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_pref_foodDislike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b8/3tlxzlvw3fpm7j8tfnaegcpkuegc5j0.mp3"
    },
    {
      "title": "收到赠礼·其一",
      "desc": "原来美食在舌尖起舞，指的就是这样的感觉…好神奇呀！",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_spice_pref_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/9f/nnpcvpqfhz4t9xk0ezbv7b1vctqzore.mp3"
    },
    {
      "title": "收到赠礼·其二",
      "desc": "谢谢你。就像我不断练习跳舞一样，这道菜肴，一定也凝结着你的心血吧。",
      "voicefile": "VO_friendship/VO_nilou/vo_nilou_spice_normal_01",
      "localAudio": null,
