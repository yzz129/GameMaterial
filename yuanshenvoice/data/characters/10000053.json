  "voicePackageEn": "Sayu",
  "quoteCount": 77,
  "friendLines": [
    {
      "title": "初次见面…",
      "desc": "「终末番」早柚，参上。\n呼——如果没有什么事情的话，我先去睡觉了。对了，不准趁我睡觉的时候偷偷摸我的头。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_draw_appear",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e7/dwln1wmy719whjwspefa16zgvlamdre.mp3"
    },
    {
      "title": "闲聊·睡着",
      "desc": "呼啊…呼噜呼噜——",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_character_idle_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/a1/hadhb2v3m9lw4n55alohptk6ipmc2up.mp3"
    },
    {
      "title": "闲聊·工作",
      "desc": "工作还不如睡觉。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_character_idle_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/16/7bgmxxmcps558g1a2b14l78a50caj1b.mp3"
    },
    {
      "title": "闲聊·长高",
      "desc": "什么时候才能长高呢？",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_character_idle_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/19/q2uaif2mcs0bqsqhna7j4ma41240yny.mp3"
    },
    {
      "title": "下雨的时候…",
      "desc": "快躲雨，被雨淋到就长不高了。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_weather_heavyRain_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/75/i8mq1j2zdoay83froec01e8iwib20km.mp3"
    },
    {
      "title": "打雷的时候…",
      "desc": "好大的动静，不过只要整个人都钻到被子里就能安稳睡觉了。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_weather_thunder_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/53/msh8077ybs9sodd4lrleofhmqng7q1p.mp3"
    },
    {
      "title": "下雪的时候…",
      "desc": "雪天很方便躲藏。比如说「雪降之隐」这种忍术，借助飘雪隐去身形，等别人察觉的时候，对方的眼前就只剩下飘落的雪花了。啊，你千万不要把这些告诉巫女姐姐。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_weather_snowy_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/83/r7ywajbmbkvoc5p2a8xot2v4wcnewwv.mp3"
    },
    {
      "title": "阳光很好…",
      "desc": "舒舒服服的好天气，啊——好困哦。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_weather_sunny_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4d/0ffh9ucj6law4fb4w8zbyjt2go6awpf.mp3"
    },
    {
      "title": "起风的时候…",
      "desc": "风起之时，便是开溜的好时机。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_weather_breezy_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/06/nwd6ls56awxdu5bgslx0q3wfsgdyyiv.mp3"
    },
    {
      "title": "刮大风了…",
      "desc": "风吹得眼睛睁不开了，不如就这样，闭起眼睛睡一觉吧。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_weather_gale_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/62/6apkkzapsxl2fai2qifepa8l6fcsudq.mp3"
    },
    {
      "title": "早上好…",
      "desc": "已经…已经早上了吗？再睡10分钟…就10分钟嘛…那、那5分钟也行…呼…",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_dialog_greetingMorning",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d3/c6auprj2d2xzacwqm3d0u268ngkomje.mp3"
    },
    {
      "title": "中午好…",
      "desc": "好困，午睡时间还没到吗？",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_dialog_greetingNoon",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/1a/09iiy0b1q88u5bfd8x31ubcbx0akzyt.mp3"
    },
    {
      "title": "晚上好…",
      "desc": "确认完毕，方圆十里内没有巫女姐姐的踪影。今晚可以睡个好觉啦~",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_dialog_greetingNight",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/4a/6p3eex25h4g9p484w0j6nwm0sw8oty3.mp3"
    },
    {
      "title": "晚安…",
      "desc": "终于…可以睡觉了…晚…晚安…",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_dialog_greetingNight2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/91/pc43kk6hhlsi4etw5e6j4bhmq7r3gyb.mp3"
    },
    {
      "title": "关于早柚自己·终末番",
      "desc": "我虽然属于「终末番」，但交给我的工作无非就是些情报收集、偷取物品之类的琐事。所以…所以不做也没有什么关系嘛。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_dialog_idle",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/0/02/ooemhlgpq52q90omr3y73dbz900485z.mp3"
    },
    {
      "title": "关于早柚自己·旷工",
      "desc": "「终末番」的工作本来就没什么意义嘛，一直拖着不做，就会有更合适的人去做。但是睡觉不一样啊，只要睡得够久，说不定哪天就能长高了，这可是意义非凡的。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_dialog_idle2",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/9/97/huyf0mom5mmzxmed4kwqspdp4ohpdw6.mp3"
    },
    {
      "title": "关于我们·帮个忙",
      "desc": "如果巫女姐姐来了，记得告诉我一声哦，我稍微睡…啊不，休息会儿。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_dialog_close",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d1/8q4slc8l937o9c3kn1337z8isn87jme.mp3"
    },
    {
      "title": "关于我们·摸摸头",
      "desc": "摸摸头？唔，如果是你的话...那好吧，我不会咬你的，但是不能摸太久了，否则会长不高的！",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_dialog_close1",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/1e/pamtvjm3r44h0m2h511v1pvr5sbjnpc.mp3"
    },
    {
      "title": "关于「神之眼」…",
      "desc": "双手剑真的很重，光靠忍术的话，我肯定举不起来。但是有了「神之眼」就不一样了，所以不管怎么说，「神之眼」对我帮助很大。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_dialog_pendant",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/a1/c28fp8dmepq8refgc95u4a5z6v6vkpw.mp3"
    },
    {
      "title": "有什么想要分享…",
      "desc": "老师说我是我们流派最后一代传人了。毕竟也不是什么特别适合战斗的流派，我学的也都是些逃跑和隐蔽气息用的忍术，这也是没办法的事情吧…",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_dialog_share_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/3/31/c4xihkphs9j833emzzii9e2w78ijw4n.mp3"
    },
    {
      "title": "感兴趣的见闻…",
      "desc": "你知道貉吗？一种比狸猫可爱得多的小动物，下次带你一起去看看吧~",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_pref_gift",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d1/1sdafcy81vfo91sca1agqcgt1mqnpir.mp3"
    },
    {
      "title": "关于神里绫华…",
      "desc": "神里家的大小姐优雅又端庄，但是她专门任命了一位巫女姐姐来监督我，不让我偷懒…怎会如此…",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_teammate_ayaka_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/db/pts0hl2izzea8yq655qwvfhmuktqbcr.mp3"
    },
    {
      "title": "关于神里绫人…",
      "desc": "我在树上休息的时候，经常会听到巫女姐姐们在聊他，似乎是一位工作很忙的大人。真是奇怪，工作什么的明明旷掉就好了…",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_teammate_ayato_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/7/7c/43kkjfa81xq5n74x6qhv126jvzgxjjp.mp3"
    },
    {
      "title": "关于托马…",
      "desc": "明明都有神之眼了，他每次出现还是缠着我说想要学忍术，真是搞不懂。而且我睡觉的时间都不够，哪有时间教他嘛。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_teammate_thoma_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/6b/8nco0yk2xlixw6utm7xkrf11x5txf01.mp3"
    },
    {
      "title": "关于宵宫…",
      "desc": "她每次碰到我就说什么，小狸猫我们一起去祭典玩之类的话。我才不是狸猫，也不想去祭典。说是一起去玩，其实就是想着在祭典上让我配合她的烟火表演忍术，但是这和「终末番」的工作有什么关联嘛！",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_teammate_yoimiya_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/4/44/lz73x0x9q2rkzzj61xihysj9vv6qgog.mp3"
    },
    {
      "title": "关于雷电将军…",
      "desc": "那位大人…不是我能见到的人物。想知道更多事情的话，或许问问绫华大小姐比较好。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_teammate_raidenShogun_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/ab/d7xr2bbh9g1d124ycn5h9qgnykx9nm9.mp3"
    },
    {
      "title": "关于八重神子…",
      "desc": "她总喜欢摸我的头，可是我不敢咬她，也不敢反抗，总感觉如果拒绝了她会发生很可怕的事情。但是，再这样被摸下去，我会不会真的长不高了？怎么办呀…",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_teammate_yaeMiko_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/b/b0/pf77g1czyywauo140lzide3kvznjent.mp3"
    },
    {
      "title": "关于荒泷一斗…",
      "desc": "怎么会有这么吵吵嚷嚷的人，而且他还能长这么高！",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_teammate_itto_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/6a/32rrz7nufcdulcwnolqxcadynzoysdv.mp3"
    },
    {
      "title": "关于久岐忍…",
      "desc": "没什么印象的名字，让我想想…欸？她是荒泷一斗的小弟吗？那肯定也是干扰睡眠的人，毕竟有个词叫做一丘之貉，啊不对，是一丘之狸！",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_teammate_oniori_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/19/6dkicoirbad62op6tw7zgtbrwdlfpa1.mp3"
    },
    {
      "title": "关于绮良良…",
      "desc": "有次我午觉睡醒，感觉身后暖和和的，一转头就看见有只猫正蜷着睡觉，关键是有一对毛茸茸的尾巴！吓得我差点从树枝上掉下去。这，这也是变身术吗？",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_teammate_kirara_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/23/f9xjrm3k99l8q4e3fh0jt9s23ziqcc1.mp3"
    },
    {
      "title": "关于梦见月瑞希…",
      "desc": "奇怪的紫色妖怪…被她盯着的时候，感觉好像要被吃掉一样…唔！惹不起，我还是躲着她走吧！",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_teammate_mizuki_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/c/cd/VO_ZH_Sayu_About_Yumemizuki_Mizuki.ogg"
    },
    {
      "title": "想要了解早柚·其一",
      "desc": "呼——",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_friendship_01",
      "localAudio": null,
      "audioUrl": "https://static.wikia.nocookie.net/gensin-impact/images/c/ce/VO_ZH_Sayu_More_About_Sayu_-_01.ogg"
    },
    {
      "title": "想要了解早柚·其二",
      "desc": "呃…你是问我忍术流派的名字吗？那个…想不起来了啦，我还没睡醒，我再去睡一觉，睡醒后说不定就能想起来了。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_friendship_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/aa/j6tylnksoloagse74xi7w4wsmtjykoz.mp3"
    },
    {
      "title": "想要了解早柚·其三",
      "desc": "好吧，告诉你也行。你先答应我不准笑，不然我就再也不理你了。我们流派叫做——呜呼流…\n说是因为我们流派的忍术以戏弄敌人为长而取的名字，可是，可是…唉。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_friendship_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f3/aorzu68n7z6lzbj8wvegvey1j4751s1.mp3"
    },
    {
      "title": "想要了解早柚·其四",
      "desc": "你会爬树吗？我非常擅长这个，可以教你哦。还有，神社那边有棵树特别适合偷…啊不，特别适合小憩。下次你想睡午觉的时候，记得来找我，我们一起爬上去午睡吧。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_friendship_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/f1/6qq469tx7akmus2ofe32cdr7l85f6kp.mp3"
    },
    {
      "title": "想要了解早柚·其五",
      "desc": "其实这套衣服是老师给我的，说是以貉为原型做的，还有助于我逃跑什么的…然后又说我已经长大了可以独当一面了，但也要保护好自己，说完老师就离开了我。可我这个身高，真的能独当一面吗…\n唔…欸？你是说你会陪着我吗？你真的不会离开我吗？",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_friendship_05",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/5c/3408i4ljgis5keox6i8070bji8oc1gs.mp3"
    },
    {
      "title": "早柚的爱好…",
      "desc": "套上衣服上的帽子，不用担心会被巫女姐姐找到，然后睡个天昏地暗，这应该是世界上最幸福的事情了吧。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_pref_hobby",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d2/lhkc222sl2r9uc1g49novzvqpv3mugj.mp3"
    },
    {
      "title": "早柚的烦恼·误会",
      "desc": "很多人第一次见到我的时候，都会大呼小叫，还把我当成狸猫。可早柚就是早柚，才不是狸猫。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_dialog_annoyed_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/d/d6/ghjzvumzajn363krpt4p5akyqlehlyj.mp3"
    },
    {
      "title": "早柚的烦恼·身高",
      "desc": "什么时候才能长高呢？跟我同年的人身高都快是我的两倍了，可我还…不行，再睡久一点一定能长高的！我要睡觉了，晚安。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_dialog_annoyed_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/c/cf/97snhow5ko96aohd000zrpm35gzzfq1.mp3"
    },
    {
      "title": "早柚的烦恼·死循环",
      "desc": "我上次听人说，烦恼太多也会长不高…呜，我该怎么办才好…",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_dialog_annoyed_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/e8/mmzgyy73h6ro4xuqk8e9hw3ppus3kvv.mp3"
    },
    {
      "title": "喜欢的食物…",
      "desc": "能一下子提供很多能量的食物吧，比如说饭团。睡醒了吃一个就不会头晕眼花，然后又能继续睡觉了。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_pref_foodLike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/1/1f/c1m9phyi4hmif6nyhexpfq3eli3kkzy.mp3"
    },
    {
      "title": "讨厌的食物…",
      "desc": "想要长高的话，就不能挑食！说来最近好像身高也没有变化，是不是因为蔬菜吃少了，但是沙拉真的没有办法提供饱腹感，而且还苦苦的，呜欸——",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_pref_foodDislike",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/51/kzb09u24ljqacpshux3ony8yxhkpbx8.mp3"
    },
    {
      "title": "收到赠礼·其一",
      "desc": "肚子好饱。这下可以安心睡觉啦。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_spice_pref_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/f/fe/c9x2bj1o9yacj21sxppgrs2o0baehpb.mp3"
    },
    {
      "title": "收到赠礼·其二",
      "desc": "吃着吃着…就困了。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_spice_normal_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/e/ec/m25yncojl6lhs4vyh2eo2r5gk5prqjv.mp3"
    },
    {
      "title": "收到赠礼·其三",
      "desc": "要想个办法…逃走。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_spice_dislike_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/2b/dflfpyvzy5yffa8fvdkje6a9dlt0zp5.mp3"
    },
    {
      "title": "生日…",
      "desc": "你有什么想学的忍术吗？我可以教你！当然仅限于我会的。呃？你问我为什么不睡觉？嗯…我还不困，而且，而且今天是特别的日子，我不可以睡过去，因为我想亲口对你说——生日快乐呀。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_pref_birthday",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/6/62/0yg46jnrxi7g6uhlnr9n7gp639vtij8.mp3"
    },
    {
      "title": "突破的感受·起",
      "desc": "我有长高一点点吗？",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_starUp_01",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/5/5c/lmycrur67nrs8wnnker4zdez50vnmf1.mp3"
    },
    {
      "title": "突破的感受·承",
      "desc": "太好了，能溜得更快了，这下子肯定不会被抓住了。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_starUp_02",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/2/2b/tu1wvcxagkxr5afetwaiqeri4spgek6.mp3"
    },
    {
      "title": "突破的感受·转",
      "desc": "谢谢你帮我收集了那么多材料，要是我自己来的话…肯定在路上就会睡着了。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_starUp_03",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/8/87/l2dpwiu2n48h0mv3lepwnrc5c7j1taq.mp3"
    },
    {
      "title": "突破的感受·合",
      "desc": "我好像确实像老师说的那样，可以独当一面了。这样子长不长高或许对我来说也没有那么重要了，因为现在重要的是…有你陪在我身边。",
      "voicefile": "VO_friendship/VO_sayu/vo_sayu_starUp_04",
      "localAudio": null,
      "audioUrl": "https://patchwiki.biligame.com/images/ys/a/a1/l620k6ctzo7l90loo6xn1w9kohzz2xl.mp3"
    }
  ],
